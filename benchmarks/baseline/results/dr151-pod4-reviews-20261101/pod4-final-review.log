    41	def dataset(specification: dict, cache: Path, *, download: bool, admission=None):
    42	    from huggingface_hub import snapshot_download
    43	    from sklearn.model_selection import StratifiedShuffleSplit
    44	
    45	    folder = Path(
    46	        snapshot_download(
    47	            specification["dataset"],
    48	            revision=specification["revision"],
    49	            repo_type="dataset",
    50	            cache_dir=cache / "hub",
    51	            allow_patterns=["train.jsonl", "test.jsonl"],
    52	            local_files_only=not download,
    53	            max_workers=2,
    54	        )
    55	    )
    56	    if admission is not None:
    57	        size = sum((folder / f"{split}.jsonl").stat().st_size for split in ("train", "test"))
    58	        admission(size * 32, "SetFit decoded input and temporary JSON records")
    59	    train, evaluation = (
    60	        [
    61	            json.loads(line)
    62	            for line in (folder / f"{split}.jsonl").read_text(encoding="utf-8").splitlines()
    63	        ]
    64	        for split in ("train", "test")
    65	    )
    66	    if len(train) <= 1000:
    67	        raise ValueError("reconstruction needs more than 1000 training examples")
    68	    labels = np.array([row["label"] for row in train])
    69	    splitter = StratifiedShuffleSplit(n_splits=1, train_size=1000, random_state=0)
    70	    chosen, _ = next(splitter.split(np.zeros(len(train)), labels))
    71	    return (
    72	        [train[i]["text"] for i in chosen],
    73	        labels[chosen],
    74	        [row["text"] for row in evaluation],
    75	        np.array([row["label"] for row in evaluation]),
    76	    )
