    11	def spread(values):
    12	    return (
    13	        {"median": statistics.median(values), "min": min(values), "max": max(values)}
    14	        if values
    15	        else None
    16	    )
    17	
    18	
    19	def runtime(row):
    20	    keys = ("runtime_package", "runtime_package_version", "package_location", "runtime_fingerprint")
    21	    return {key: row.get(key) for key in keys}
    22	
    23	
    24	def runtime_eligible(row):
    25	    expected = "model2vec" if row["kind"] in ("mlp", "model2vec-linear") else "fse"
    26	    return row.get("runtime_package") == expected and all(runtime(row).values())
    27	
    28	
    29	def head_runtime_stable(rows):
    30	    if rows[0]["kind"] != "model2vec-linear":
    31	        return True
    32	    heads = [row.get("linear_head_runtime") or {} for row in rows]
    33	    valid = all(
    34	        head.get("runtime_package") == "scikit-learn" and all(runtime(head).values())
    35	        for head in heads
    36	    )
    37	    return valid and len({json.dumps(runtime(head), sort_keys=True) for head in heads}) == 1
    38	
    39	
    40	def arm(rows):
    41	    first = rows[0]
    42	    stable = len({json.dumps(runtime(row), sort_keys=True) for row in rows}) == 1
    43	    stable = stable and all(runtime_eligible(row) for row in rows) and head_runtime_stable(rows)
    44	    return {
    45	        "runtime": runtime(first),
    46	        "runtime_stable": stable,
    47	        "predictions_stable": len({row["output_digest"] for row in rows}) == 1,
    48	        "head": first["head"],
    49	        "normalization": first["normalization"],
    50	        "linear_head_runtime": first.get("linear_head_runtime"),
    51	        "linear_head_runtime_stable": head_runtime_stable(rows),
    52	        "texts_per_second": spread([row["texts"] / row["p50_s"] for row in rows]),
    53	        "seconds": spread([row["p50_s"] for row in rows]),
    54	        "accuracy": [row["quality"] for row in rows],
    55	        "peak_rss_bytes": max(row["peak_rss_bytes"] for row in rows),
    56	        "folded_model_file_bytes": first["folded_model_file_bytes"],
    57	        "encoder_plus_head_file_bytes": first["encoder_plus_head_file_bytes"],
    58	    }
    59	
    60	
    61	def paired_speedups(rows, accepted, labels):
    62	    pairs = {
    63	        number: {row["label"]: row for row in rows if row["round"] == number} for number in accepted
    64	    }
    65	    result = {}
    66	    for label in labels:
    67	        if label in ("fse-a", "fse-b"):
    68	            continue
    69	        result[label] = spread(
    70	            [
    71	                pair[label]["p50_s"] / pair["fse-a"]["p50_s"]
    72	                for pair in pairs.values()
    73	                if label in pair
    74	            ]
    75	        )
    76	    return result
