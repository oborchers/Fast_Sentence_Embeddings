     8	
     9	
    10	def read_jsonl(path):
    11	    return [json.loads(line) for line in path.read_text().splitlines()]
    12	
    13	
    14	def duration_rows(rows):
    15	    return bool(rows) and all(
    16	        row.get("minimum_call_seconds") == 2 and qualifies(row)
    17	        for row in rows
    18	        if row.get("runtime_package") == "fse"
    19	    )
    20	
    21	
    22	def readme_cell(raw, checks, cell):
    23	    done = [r for r in raw if r.get("event") == "series_complete" and r["cell"] == cell]
    24	    checked = [r for r in checks if r["cell"] == cell]
    25	    if len(done) != 1 or len(checked) != 1:
    26	        return {"cell": cell, "eligible": False}
    27	    rows = [r for r in raw if r.get("series_id") == done[0]["series_id"]]
    28	    operations = [r for r in rows if r.get("event") == "operation"]
    29	    rounds = [r for r in rows if r.get("event") == "round_complete"]
    30	    against = cell.rsplit("/", 1)[-1]
    31	    labels = ["fse-a", "fse-b", *([] if against == "table" else [against])]
    32	    summary = encode(done[0], operations, rounds, labels, checked[0])
    33	    summary["eligible"] &= duration_rows(operations) and duration_rows(
    34	        list(checked[0]["records"].values())
    35	    )
    36	    return summary
    37	
    38	
    39	def readme(path, expected):
    40	    raw = read_jsonl(path / "speed-results.jsonl")
    41	    checks = read_jsonl(path / "output-checks.jsonl")
    42	    return {"cells": [readme_cell(raw, checks, cell) for cell in expected]}
    43	
    44	
    45	def classification(path):
    46	    raw = read_jsonl(path / "speed-results.jsonl")
    47	    result = classify(raw)
    48	    for cell in result["cells"]:
    49	        operations = [
    50	            r
    51	            for r in raw
    52	            if r.get("event") == "operation" and r.get("series_id") == cell["series_id"]
    53	        ]
    54	        cell["eligible"] &= duration_rows(operations)
    55	    return result
     1	"""Reject short fse calls individually, without hiding them behind a median."""
     2	
     3	import math
     4	
     5	
     6	def qualifies(row):
     7	    minimum = row.get("minimum_call_seconds", 0)
     8	    if minimum == 0:
     9	        return True
    10	    values = [row.get("first_encode_s", row.get("first_predict_s")), *row.get("warm_seconds", [])]
    11	    if row.get("timed_passes", len(values) - 1) != len(values) - 1:
    12	        return False
    13	    if len(values) < 2:
    14	        return False
    15	    nested = row.get("encoder_call_seconds")
    16	    if row.get("kind") == "encode-matmul" and nested is None:
    17	        return False
    18	    if nested is not None:
    19	        if len(nested) != len(values):
    20	            return False
    21	        values.extend(nested)
    22	    return (
    23	        math.isfinite(minimum)
    24	        and minimum > 0
    25	        and len(values) >= 2
    26	        and all(
    27	            isinstance(value, (int, float)) and math.isfinite(value) and value >= minimum
    28	            for value in values
    29	        )
    30	    )
