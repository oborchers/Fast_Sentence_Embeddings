    86	def split(pages: list[str], scores: np.ndarray):
    87	    order = np.random.default_rng(0).permutation(len(pages))
    88	    train, evaluation = order[:-EVAL], order[-EVAL:]
    89	    return (
    90	        [pages[i] for i in train],
    91	        scores[train] >= 3,
    92	        [pages[i] for i in evaluation],
    93	        scores[evaluation] >= 3,
    94	    )
