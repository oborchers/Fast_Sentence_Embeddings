   181	def publish_summary(folder: Path):
   182	    source = folder / "speed-results.jsonl"
   183	    rows = [json.loads(line) for line in source.read_text().splitlines()]
   184	    result = summarize(rows)
   185	    (folder / "classification-summary.json").write_text(json.dumps(result, indent=2) + "\n")
   186	    emit("classification-summary-" + str(len(result["cells"])), result)
   187	    return result

