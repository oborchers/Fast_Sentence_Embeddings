    79	def complete_rounds(operations, rounds, expected):
    80	    accepted = set()
    81	    for number in {row["round"] for row in rounds if row.get("valid") and row.get("complete")}:
    82	        current = [row for row in operations if row["round"] == number]
    83	        if len(current) == len(expected) and {row["label"] for row in current} == expected:
    84	            accepted.add(number)
    85	    return accepted
    86	
    87	
    88	def evidence(operations, rounds):
    89	    kinds = {row["kind"] for row in operations}
    90	    expected = (
    91	        {"fse-a", "fse-b", "model2vec-mlp"}
    92	        if "mlp" in kinds
    93	        else {"fse-a", "fse-b", "encode-matmul", "model2vec-same-linear"}
    94	    )
    95	    accepted = complete_rounds(operations, rounds, expected)
    96	    times = [row["p50_s"] for row in operations if row["label"] in ("fse-a", "fse-b")]
    97	    positive = bool(times) and all(math.isfinite(value) and value > 0 for value in times)
    98	    ratio = max(times) / min(times) if positive else None
    99	    equal_inputs = len({(row["input_digest"], row["texts"]) for row in operations}) == 1
   100	    return accepted, {
   101	        "complete_rounds": len(accepted),
   102	        "all_control_max_ratio": ratio,
   103	        "symmetric_aa_band": [1 / ratio, ratio] if ratio is not None else None,
   104	        "equal_inputs": equal_inputs,
   105	        "eligible": len(accepted) >= 3 and ratio is not None and ratio <= 1.1 and equal_inputs,
   106	    }
