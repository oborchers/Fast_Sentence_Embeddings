    89	def round_observation(commands, ordered, workers, deadline, output, context, hardware):
    90	    rows = []
    91	    for label in ordered:
    92	        row = operation(commands[label], label, workers, deadline, output, context, hardware)
    93	        append(output / "speed-results.jsonl", row)
    94	        rows.append(row)
    95	    band = aa_band(rows)
    96	    equal_inputs = len({row["input_digest"] for row in rows}) == 1
    97	    long_enough = all(
    98	        qualifies(row)
    99	        for row in rows
   100	        if row["label"] in ("fse-a", "fse-b") or row.get("runtime_package") == "fse"
   101	    )
   102	    good = band["aa_max_ratio"] <= 1.1 and equal_inputs and long_enough
   103	    append(
   104	        output / "speed-results.jsonl",
   105	        {
   106	            **context,
   107	            **hardware,
   108	            **band,
   109	            "event": "round_complete",
   110	            "valid": good,
   111	            "complete": True,
   112	            "equal_inputs": equal_inputs,
   113	            "minimum_call_duration_passed": long_enough,
   114	        },
   115	    )
   116	    return good, band
