    34	
    35	def classifier(folder, description, kind):
    36	    manifest = json.loads((folder / "manifest.json").read_text())
    37	    count = description["rows"]
    38	    size = (folder / description["file"]).stat().st_size
    39	    width, outputs = (
    40	        manifest["linear_head"]["original_embedding_dim"],
    41	        manifest["linear_head"]["outputs"],
    42	    )
    43	    models = sum(
    44	        p.stat().st_size
    45	        for p in folder.rglob("*")
    46	        if p.is_file() and p.suffix in (".safetensors", ".npz", ".joblib")
    47	    )
    48	    required = decoded_bytes(count, size) + models * 2 + count * max(outputs, 2) * 16
    49	    if kind in ("encode-matmul", "model2vec-linear", "mlp"):
    50	        required += count * width * 4 * 3
    51	    if kind == "mlp":
    52	        required += count * 512 * 4 * 4
    53	    return admit(
    54	        required, f"{kind} decoded inputs, model, embeddings and overlapping intermediates"
    55	    )
