    40	def digest(rows: list[str]) -> str:
    41	    from fse._container._hash import Hasher
    42	
    43	    hasher = Hasher()
    44	    for row in rows:
    45	        data = row.encode("utf-8")
    46	        hasher.update(len(data).to_bytes(8, "little"))
    47	        hasher.update(data)
    48	    return hasher.checksum()
