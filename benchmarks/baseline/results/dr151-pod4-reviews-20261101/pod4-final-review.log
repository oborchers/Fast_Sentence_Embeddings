     1	"""Conservative cgroup admission before large input or comparator allocations."""
     2	
     3	import json
     4	from pathlib import Path
     5	
     6	
     7	def budget():
     8	    root = Path("/sys/fs/cgroup")
     9	    maximum = (root / "memory.max").read_text().strip()
    10	    if maximum == "max":
    11	        raise RuntimeError("pod requires a finite cgroup memory limit")
    12	    return int(maximum), int((root / "memory.current").read_text())
    13	
    14	
    15	def admit(required, purpose):
    16	    maximum, current = budget()
    17	    if not isinstance(required, int) or required < 0:
    18	        raise ValueError("allocation budget must be a nonnegative integer")
    19	    if current + required > maximum * 0.85:
    20	        raise MemoryError(
    21	            f"{purpose}: conservative allocation budget exceeds available cgroup memory"
    22	        )
    23	    return {"limit": maximum, "current": current, "additional_budget": required, "scope": purpose}
