    25	
    26	def decoded_bytes(count, file_bytes):
    27	    return file_bytes * 4 + count * 256
    28	
    29	
    30	def encoding(count, width, file_bytes, model_bytes):
    31	    required = decoded_bytes(count, file_bytes) + count * width * 4 * 4 + model_bytes * 2
    32	    return admit(required, "encoding inputs, model and overlapping matrices")
