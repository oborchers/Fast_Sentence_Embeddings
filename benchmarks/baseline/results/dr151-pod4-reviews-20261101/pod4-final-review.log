   119	def series(commands, workers, output, deadline, cell, *, minimum_seconds=0):
   120	    if sys.platform != "linux":
   121	        raise RuntimeError("pod timing policy is restricted to Linux")
   122	    hardware = environment()
   123	    identifier = uuid.uuid4().hex
   124	    start = time.monotonic()
   125	    valid, ratios, controls = 0, [], []
   126	    failed = False
   127	    labels = list(commands)
   128	    for attempt in range(1000 if minimum_seconds else 9):
   129	        if time.monotonic() >= deadline:
   130	            break
   131	        ordered = labels[attempt % len(labels) :] + labels[: attempt % len(labels)]
   132	        context = {"series_id": identifier, "cell": cell, "round": attempt}
   133	        try:
   134	            good, band = round_observation(
   135	                commands, ordered, workers, deadline, output, context, hardware
   136	            )
   137	            ratios.append(band["aa_max_ratio"])
   138	            controls.extend(band["control_seconds"])
   139	            valid += good
   140	        except (RuntimeError, TimeoutError, subprocess.TimeoutExpired) as error:
   141	            failed = True
   142	            append(
   143	                output / "speed-results.jsonl",
   144	                {
   145	                    **context,
   146	                    **hardware,
   147	                    "event": "round_complete",
   148	                    "valid": False,
   149	                    "complete": False,
   150	                    "reason": repr(error),
   151	                },
   152	            )
   153	            break
   154	        if valid >= 3 and time.monotonic() - start >= minimum_seconds:
   155	            break
   156	    # Probe rejection uses every observed A/A round, including noisy rounds.
   157	    elapsed = time.monotonic() - start
   158	    control_ratio = max(controls) / min(controls) if controls else None
   159	    result = {
   160	        "event": "series_complete",
   161	        "series_id": identifier,
   162	        "cell": cell,
   163	        "valid_rounds": valid,
   164	        "required_rounds": 3,
   165	        "complete": not failed
   166	        and valid >= 3
   167	        and bool(ratios)
   168	        and max(ratios) <= 1.1
   169	        and control_ratio <= 1.1
   170	        and elapsed >= minimum_seconds,
   171	        "aa_max_ratio": control_ratio,
   172	        "aa_within_round_max_ratio": max(ratios) if ratios else None,
   173	        "symmetric_aa_band": [1 / control_ratio, control_ratio] if controls else None,
   174	        "noise_label": noise_label(control_ratio),
   175	        "incomplete_round": failed,
   176	        "aa_control_max_ratio": control_ratio,
   177	        "aa_control_seconds_range": [min(controls), max(controls)] if controls else None,
   178	        "minimum_observation_seconds": minimum_seconds,
   179	        "seconds": elapsed,
   180	        **hardware,
   181	    }
   182	    append(output / "speed-results.jsonl", result)
   183	    return result
