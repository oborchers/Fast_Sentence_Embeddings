   109	def summarize_cell(identifier, completed, operations, rounds):
   110	    accepted, observed = evidence(operations, rounds)
   111	    rows = [row for row in operations if row["round"] in accepted]
   112	    if not rows:
   113	        return {
   114	            "series_id": identifier,
   115	            "cell": completed["cell"],
   116	            "eligible": False,
   117	            "reason": "no valid complete rounds",
   118	            "aa": completed,
   119	            "verified_evidence": observed,
   120	        }
   121	    labels = sorted({row["label"] for row in rows})
   122	    arms = {label: arm([row for row in rows if row["label"] == label]) for label in labels}
   123	    first = rows[0]
   124	    controls = [row for row in operations if row["label"] in ("fse-a", "fse-b")]
   125	    stable_controls = (
   126	        len({row["output_digest"] for row in controls}) == 1
   127	        and len({json.dumps(runtime(row), sort_keys=True) for row in controls}) == 1
   128	    )
   129	    ratios = paired_speedups(rows, accepted, labels)
   130	    eligible = (
   131	        completed["complete"]
   132	        and observed["eligible"]
   133	        and completed.get("valid_rounds") == observed["complete_rounds"]
   134	        and completed.get("aa_max_ratio") is not None
   135	        and math.isclose(
   136	            completed["aa_max_ratio"], observed["all_control_max_ratio"], rel_tol=1e-12
   137	        )
   138	        and stable_controls
   139	        and all(a["runtime_stable"] and a["predictions_stable"] for a in arms.values())
   140	    )
   141	    return {
   142	        "series_id": identifier,
   143	        "cell": completed["cell"],
   144	        "eligible": eligible,
   145	        "source_commit": first["commit"],
   146	        "dataset": first["dataset"],
   147	        "suite": first["suite"],
   148	        "dataset_revision": first["training_record"]["dataset_revision"],
   149	        "model": first["model"],
   150	        "revision": first["revision"],
   151	        "table_dtype": "float32",
   152	        "requested_workers": first["requested_workers"],
   153	        "texts": first["texts"],
   154	        "input_digest": first["input_digest"],
   155	        "machine": first["machine"],
   156	        "cpu": first["cpu"],
   157	        "dates_utc": sorted({row["time_utc"][:10] for row in rows}),
   158	        "primary_fse_summary": "fse-a; fse-b reported separately",
   159	        "arms": arms,
   160	        "paired_fse_folded_speedup_vs_counterpart": ratios,
   161	        "aa": completed,
   162	        "verified_evidence": observed,
   163	        "control_predictions_stable": stable_controls,
   164	        "note": "fine-tuned Model2Vec MLP is a different trained model; model2vec-same-linear uses the same sklearn coefficients",
   165	    }
   166	
   167	
   168	def summarize(rows):
   169	    result = []
   170	    for done in rows:
   171	        if done.get("event") != "series_complete":
   172	            continue
   173	        identifier = done["series_id"]
   174	        current = [row for row in rows if row.get("series_id") == identifier]
   175	        operations = [row for row in current if row.get("event") == "operation"]
   176	        rounds = [row for row in current if row.get("event") == "round_complete"]
   177	        result.append(summarize_cell(identifier, done, operations, rounds))
   178	    return {"format": "classifier-folding-summary-v1", "cells": result}
