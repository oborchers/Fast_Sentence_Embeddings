    10	
    11	def kill_group(pid, sig):
    12	    with contextlib.suppress(ProcessLookupError):
    13	        os.killpg(pid, sig)
    14	
    15	
    16	def run(command, output, seconds):
    17	    if seconds <= 0:
    18	        return 124
    19	    with output.open("ab", buffering=0) as log:
    20	        child = subprocess.Popen(
    21	            command, stdout=log, stderr=subprocess.STDOUT, start_new_session=True
    22	        )
    23	        try:
    24	            status = child.wait(timeout=seconds)
    25	        except subprocess.TimeoutExpired:
    26	            status = 124
    27	        finally:
    28	            kill_group(child.pid, signal.SIGTERM)
    29	            with contextlib.suppress(subprocess.TimeoutExpired):
    30	                child.wait(timeout=10)
    31	            kill_group(child.pid, signal.SIGKILL)
    32	            child.wait()
    33	    return status if status >= 0 else 128 - status
