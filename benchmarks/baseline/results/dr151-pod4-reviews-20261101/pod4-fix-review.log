     1	"""Reject short fse calls individually, without hiding them behind a median."""
     2	
     3	import math
     4	
     5	
     6	def qualifies(row):
     7	    minimum = row.get("minimum_call_seconds", 0)
     8	    if minimum == 0:
     9	        return True
    10	    values = [row.get("first_encode_s", row.get("first_predict_s")), *row.get("warm_seconds", [])]
    11	    nested = row.get("encoder_call_seconds")
    12	    if row.get("kind") == "encode-matmul" and nested is None:
    13	        return False
    14	    if nested is not None:
    15	        if len(nested) != len(values):
    16	            return False
    17	        values.extend(nested)
    18	    return (
    19	        math.isfinite(minimum)
    20	        and minimum > 0
    21	        and len(values) >= 2
    22	        and all(
    23	            isinstance(value, (int, float)) and math.isfinite(value) and value >= minimum
    24	            for value in values
    25	        )
    26	    )
     1	"""Stdlib-only artifact export, including partial JSONL files after a hard timeout."""
     2	
     3	import base64
     4	import gzip
     5	import hashlib
     6	import json
     7	import sys
     8	from pathlib import Path
     9	
    10	
    11	def emit(name, value):
    12	    compressed = gzip.compress(json.dumps(value, ensure_ascii=True).encode(), mtime=0)
    13	    encoded = base64.b64encode(compressed).decode()
    14	    chunks = [encoded[start : start + 160] for start in range(0, len(encoded), 160)]
    15	    print(
    16	        f"DR190_BEGIN {name} {len(compressed)} {hashlib.sha256(compressed).hexdigest()}", flush=True
    17	    )
    18	    for index, chunk in enumerate(chunks):
    19	        print(f"DR190_DATA {name} {index} {chunk}", flush=True)
    20	    print(f"DR190_END {name} {len(chunks)}", flush=True)
    21	
    22	
    23	def jsonl_value(path, content):
    24	    rows, errors = [], []
    25	    for number, line in enumerate(content.splitlines()):
    26	        try:
    27	            rows.append(json.loads(line))
    28	        except json.JSONDecodeError:
    29	            errors.append({"line": number + 1, "content": line})
    30	    return {"path": str(path), "format": "jsonl", "rows": rows, "parse_errors": errors}
    31	
    32	
    33	def failures(value):
    34	    result = []
    35	    if value.get("parse_errors"):
    36	        result.append({"path": value["path"], "reason": "partial JSONL record"})
    37	    for row in value.get("rows", []):
    38	        if not isinstance(row, dict):
    39	            continue
    40	        if row.get("event") == "series_complete" and not row["complete"]:
    41	            result.append({"cell": row.get("cell"), "reason": "incomplete or noisy cell"})
    42	        if row.get("status") == "failed":
    43	            result.append({"model": row.get("model"), "reason": "failed invocation"})
    44	    return result
    45	
    46	
    47	def final(root, returncode, *, sentinel=True):
    48	    steps, incomplete = [], []
    49	    if (root / "pod4-plan.json").exists():
    50	        try:
    51	            sys.path.insert(0, "/dr151-repo/benchmarks/quality")
    52	            from pod4_receipts import validate
    53	
    54	            incomplete.extend(validate(root))
    55	        except (ImportError, OSError, ValueError) as error:
    56	            incomplete.append({"reason": "cannot validate Pod4 receipts: " + str(error)})
    57	    for index, path in enumerate(sorted(root.rglob("*"))):
    58	        if not path.is_file() or path.suffix not in (".json", ".jsonl", ".log", ".txt"):
    59	            continue
    60	        if "pipeline-inputs" in path.parts:
    61	            continue
    62	        name = f"final-file-{index}"
    63	        content = path.read_text(errors="replace")
    64	        value = (
    65	            jsonl_value(path, content)
    66	            if path.suffix == ".jsonl"
    67	            else {"path": str(path), "format": "text", "content": content}
    68	        )
    69	        emit(name, value)
    70	        incomplete.extend(failures(value))
    71	        steps.append({"name": name, "path": str(path)})
    72	    emit(
    73	        "manifest",
    74	        {
    75	            "complete": returncode == 0 and not incomplete,
    76	            "returncode": returncode,
    77	            "status": "complete" if returncode == 0 and not incomplete else "partial or failed",
    78	            "incomplete": incomplete,
    79	            "steps": steps,
    80	        },
    81	    )
    82	    if sentinel:
    83	        print("ALL_DONE", flush=True)
    84	
    85	
    86	if __name__ == "__main__":
    87	    if sys.argv[1] == "--failure":
    88	        emit(
    89	            "manifest",
    90	            {
    91	                "complete": False,
    92	                "returncode": int(sys.argv[2]),
    93	                "status": "export or setup failed",
    94	                "reason": sys.argv[3],
    95	            },
    96	        )
    97	    else:
    98	        final(Path(sys.argv[1]), int(sys.argv[2]), sentinel="--no-sentinel" not in sys.argv)

