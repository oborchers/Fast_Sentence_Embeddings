    50	class Lengths:
    51	    def __init__(self):
    52	        from fse._container._hash import Hasher
    53	
    54	        self.count = 0
    55	        self.histograms = {name: Counter() for name in ("words", "characters", "potion_tokens")}
    56	        self.hasher = Hasher()
    57	
    58	    def add(self, rows, tokens):
    59	        for text, count in zip(rows, tokens, strict=True):
    60	            values = (len(text.split()), len(text), count)
    61	            for name, value in zip(self.histograms, values, strict=True):
    62	                self.histograms[name][value] += 1
    63	            data = text.encode("utf-8")
    64	            self.hasher.update(len(data).to_bytes(8, "little"))
    65	            self.hasher.update(data)
    66	            self.count += 1
    67	
    68	    def add_weighted_counts(self, words, characters, tokens, weight):
    69	        if weight < 0:
    70	            raise ValueError("negative input multiplicity")
    71	        for name, value in zip(self.histograms, (words, characters, tokens), strict=True):
    72	            self.histograms[name][value] += weight
    73	        self.count += weight
    74	
    75	    def record(self):
    76	        if not self.count:
    77	            raise ValueError("length statistics require at least one complete text")
    78	        result = {"texts": self.count, "input_digest": self.hasher.checksum()}
    79	        for name, histogram in self.histograms.items():
    80	            total = sum(value * count for value, count in histogram.items())
    81	            result[name] = {"total": total, "mean": total / self.count, "median": median(histogram)}
    82	        return result
