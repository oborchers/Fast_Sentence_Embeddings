   103	def call_seconds(controls, accepted):
   104	    result = []
   105	    for number in accepted:
   106	        rows = [row for row in controls if row["round"] == number]
   107	        if len(rows) != 2 or {row["label"] for row in rows} != {"fse-a", "fse-b"}:
   108	            raise ValueError("call durations require both controls in every accepted round")
   109	        observations = {}
   110	        for row in rows:
   111	            first, warm = row["first_encode_s"], row["warm_seconds"]
   112	            if not qualifies({**row, "minimum_call_seconds": 2}):
   113	                raise ValueError("every published fse call must last at least two seconds")
   114	            observations[row["label"]] = {"first": first, "warm": warm}
   115	        result.append(observations)
   116	    if len(result) != 3:
   117	        raise ValueError("call durations require exactly three accepted rounds")
   118	    return result
