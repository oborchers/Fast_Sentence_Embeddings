   121	def extract_series(done, raw, checks, commit, journal):
   122	    operations = [r for r in raw if r.get("event") == "operation"]
   123	    rounds = [r for r in raw if r.get("event") == "round_complete"]
   124	    labels = list(dict.fromkeys(r["label"] for r in operations))
   125	    checked = series_contract(done, operations, labels, checks)
   126	    summary = summarize(done, operations, rounds, labels, checked)
   127	    if not summary["eligible"]:
   128	        raise ValueError("strict source summary rejects this series")
   129	    controls = [
   130	        r for r in operations if r["kind"] == "fse" and r["round"] in summary["accepted_rounds"]
   131	    ]
   132	    details = context(controls, checked)
   133	    source = {"commit": commit, "path": journal, "series_id": done["series_id"]}
   134	    primary = panel_row(summary, "fse-a", source, details)
   135	    primary["call_seconds"] = call_seconds(controls, summary["accepted_rounds"])
   136	    references = [label for label in labels if label not in ("fse-a", "fse-b")]
   137	    if len(references) > 1:
   138	        raise ValueError("one same-model reference is required per library series")
   139	    return summary, primary, references
