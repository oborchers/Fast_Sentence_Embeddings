    31	@contextmanager
    32	def reservation(lock: Path):
    33	    """Reserve one operation, never changing another owner's lock."""
    34	    marker = lock.parent / "pause-local.marker"
    35	    if marker.exists() or os.getloadavg()[0] >= 5:
    36	        raise TimingDeferredError("timing deferred: paused or load >= 5")
    37	    lock.mkdir()
    38	    owner = lock / "owner"
    39	    identity = f"dr151-compare pid={os.getpid()}"
    40	    try:
    41	        owner.write_text(identity, encoding="utf-8")
    42	        if marker.exists() or os.getloadavg()[0] >= 5:
    43	            raise TimingDeferredError("timing deferred after reservation")
    44	        yield
    45	    finally:
    46	        if owner.exists() and owner.read_text(encoding="utf-8") == identity:
    47	            owner.unlink()
    48	            lock.rmdir()
