    46	def arguments():
    47	    parser = argparse.ArgumentParser(description=__doc__)
    48	    parser.add_argument(
    49	        "--kind", choices=["fse", "model2vec", "rust", "fastembed", "st"], required=True
    50	    )
    51	    parser.add_argument("--threads", type=int, required=True)
    52	    parser.add_argument("--model", required=True)
    53	    parser.add_argument("--table-dtype", required=True)
    54	    parser.add_argument("--models", type=Path, required=True)
    55	    parser.add_argument("--input", type=Path, required=True)
    56	    parser.add_argument("--minimum-seconds", type=float, default=2)
    57	    parser.add_argument("--vectors-out", type=Path)
    58	    parser.add_argument("--passes", type=int, default=3)
    59	    return parser.parse_args()
    60	
    61	
    62	def main():
    63	    from threadpoolctl import threadpool_info, threadpool_limits
    64	
    65	    args = arguments()
    66	    if sys.platform != "linux":
    67	        raise RuntimeError("Pod 4 encoding runs only on Linux")
    68	    allowed = sorted(os.sched_getaffinity(0))
    69	    if args.threads < 1 or len(allowed) < args.threads:
    70	        raise ValueError("requested CPU budget exceeds the pod affinity")
    71	    os.sched_setaffinity(0, allowed[: args.threads])
    72	    os.environ["RAYON_NUM_THREADS"] = str(args.threads)
    73	    os.environ["TOKENIZERS_PARALLELISM"] = "true" if args.threads > 1 else "false"
    74	    source = json.loads(args.input.with_suffix(".identity.json").read_text())
    75	    if source["checksum"] != file_digest(args.input):
    76	        raise ValueError("shared input differs from its recorded file digest")
    77	    artifact = artifact_path(args.models, args.model, args.table_dtype)
    78	    width = int(header(artifact)["fse.output_dim"])
    79	    admission = encoding(source["texts"], width, args.input.stat().st_size, artifact.stat().st_size)
    80	    before = identity(args.kind)
    81	    if args.kind == "rust":
    82	        from compare_rust_worker import measure
    83	
    84	        options = SimpleNamespace(
    85	            model=args.model, threads=args.threads, passes=args.passes, input_file=args.input
    86	        )
    87	        record, vectors = measure(options, [])
    88	    else:
    89	        with args.input.open(encoding="utf-8") as stream:
    90	            sentences = [line.rstrip("\n") for line in stream]
    91	        if len(sentences) != source["texts"]:
    92	            raise ValueError("input row count differs from its receipt")
    93	        options = SimpleNamespace(
    94	            kind=args.kind,
    95	            threads=args.threads,
    96	            model=args.model,
    97	            passes=args.passes,
    98	            table_dtype=args.table_dtype,
    99	            fse_models=args.models,
   100	            warmup_texts=None,
   101	        )
   102	        with threadpool_limits(limits=args.threads):
   103	            record, vectors = python_measure(options, sentences)
   104	            record["threadpools"] = threadpool_info()
   105	    if len(vectors) != source["texts"]:
   106	        raise ValueError("encoded row count differs from the complete input")
   107	    verify_backend_identity(args.kind, before)
   108	    if args.vectors_out:
   109	        np.save(args.vectors_out, vectors)
   110	    record["memory_admission"] = admission
   111	    print(json.dumps(finish(args, source, before, vectors, record)))
   112	
   113	
   114	def finish(args, source, before, vectors, record):
   115	    import time
   116	
   117	    from fse._container._hash import checksum
   118	
   119	    record.update(
   120	        {
   121	            **before,
   122	            **{
   123	                key: value
   124	                for key, value in source.items()
   125	                if key not in ("file_bytes", "file", "checksum")
   126	            },
   127	            "input_file_bytes": source["file_bytes"],
   128	            "input_checksum": source["checksum"],
   129	            "effective_affinity": sorted(os.sched_getaffinity(0)),
   130	            **settings(args.kind, args.threads, source["texts"]),
   131	            "kind": args.kind,
   132	            "model": args.model,
   133	            "revision": MODELS[args.model],
   134	            "corpus": "wikitext-103-train-passages",
   135	            "shape": list(vectors.shape),
   136	            "output_digest": checksum(np.ascontiguousarray(vectors)),
   137	            "time_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
   138	            "p50_s": float(np.median(record["warm_seconds"])),
   139	            "minimum_call_seconds": args.minimum_seconds if args.kind == "fse" else 0,
   140	            "timed_passes": args.passes,
   141	        }
   142	    )
   143	    return record
   144	
   145	
   146	if __name__ == "__main__":
   147	    main()
     1	"""Seeded WikiText train passage inputs, prepared only on the Linux pod."""
     2	
     3	import json
     4	import re
     5	import shutil
     6	import sys
     7	from pathlib import Path
     8	
     9	import numpy as np
    10	from compare_artifacts import file_digest
    11	from compare_inputs import DATASETS
    12	from pod_large_inputs import write_shuffled
    13	from text_lengths import Lengths, batches, counter, token_counts
    14	
    15	SEED = 0
    16	LABEL = "sampled and shuffled WikiText-103 passages"
    17	
    18	
    19	def sampled_indices(source_count, count, seed=SEED):
    20	    if source_count < 1 or count < 1:
    21	        raise ValueError("source and sampled input must be nonempty")
    22	    generator = np.random.default_rng(seed)
    23	    indices = generator.integers(source_count, size=count, dtype=np.int64)
    24	    generator.shuffle(indices)
    25	    return indices
    26	
    27	
    28	def source_passages(cache):
    29	    if sys.platform != "linux":
    30	        raise RuntimeError("large benchmark inputs are prepared only on the Linux pod")
    31	    import pyarrow.parquet as pq
    32	    from huggingface_hub import snapshot_download
    33	
    34	    target = cache / "wikitext-train-passages.txt"
    35	    if target.exists():
    36	        return target.read_text().splitlines()
    37	    repo, revision = DATASETS["wikitext"]
    38	    snapshot = Path(
    39	        snapshot_download(
    40	            repo,
    41	            repo_type="dataset",
    42	            revision=revision,
    43	            allow_patterns=["wikitext-103-raw-v1/train-*.parquet"],
    44	            max_workers=2,
    45	        )
    46	    )
    47	    with target.open("x", encoding="utf-8") as stream:
    48	        for path in sorted((snapshot / "wikitext-103-raw-v1").glob("train-*.parquet")):
    49	            for batch in pq.ParquetFile(path).iter_batches(columns=["text"], batch_size=4096):
    50	                for text in batch.column(0).to_pylist():
    51	                    text = re.sub(r"\s+", " ", text).strip()
    52	                    if text and not text.startswith("=") and len(text.split()) >= 5:
    53	                        stream.write(text + "\n")
    54	    return target.read_text().splitlines()
    55	
    56	
    57	def sampled_lengths(source, indices):
    58	    model, tokenizer = counter()
    59	    weights = np.bincount(indices, minlength=len(source))
    60	    lengths, offset = Lengths(), 0
    61	    for batch in batches(source):
    62	        for text, tokens in zip(batch, token_counts(model, batch), strict=True):
    63	            weight = int(weights[offset])
    64	            if weight:
    65	                lengths.add_weighted_counts(len(text.split()), len(text), tokens, weight)
    66	            offset += 1
    67	    return {
    68	        **lengths.record(),
    69	        "tokenizer": tokenizer,
    70	        "statistics_method": "exact weighted full sampled input",
    71	    }
    72	
    73	
    74	def write_input(folder, source, count, seed=SEED):
    75	    folder.mkdir(parents=True, exist_ok=True)
    76	    path = folder / f"passages-{count}-seed{seed}.txt"
    77	    receipt = path.with_suffix(".identity.json")
    78	    if path.exists() or receipt.exists():
    79	        if not path.exists() or not receipt.exists():
    80	            raise ValueError("incomplete sampled input preparation")
    81	        record = json.loads(receipt.read_text())
    82	        if record["checksum"] != file_digest(path):
    83	            raise ValueError("cached sampled input differs from its receipt")
    84	        return path, record
    85	    expected = count * (sum(len(text.encode("utf-8")) + 1 for text in source) / len(source))
    86	    if shutil.disk_usage(folder).free < expected + 25 * 1024**3:
    87	        raise OSError("sampled input would leave less than 25 GiB free")
    88	    from pod4_memory import admit
    89	
    90	    admit(count * 24, "sample-index arrays and unique index workspace")
    91	    indices = sampled_indices(len(source), count, seed)
    92	    selected = np.unique(indices)
    93	    distinct = len({source[int(index)] for index in selected})
    94	    digest = write_shuffled(path, source, indices)
    95	    record = {
    96	        **sampled_lengths(source, indices),
    97	        "texts": count,
    98	        "input_digest": digest,
    99	        "checksum": file_digest(path),
   100	        "file": str(path),
   101	        "file_bytes": path.stat().st_size,
   102	        "dataset": DATASETS["wikitext"][0],
   103	        "dataset_revision": DATASETS["wikitext"][1],
   104	        "split": "train",
   105	        "input_label": LABEL,
   106	        "seed": seed,
   107	        "sampling": "uniform source positions with replacement, followed by seeded shuffle",
   108	        "source_passages": len(source),
   109	        "distinct_source_texts": len(set(source)),
   110	        "distinct_input_texts": distinct,
   111	        "distinct_sampled_positions": len(selected),
   112	        "repetition_factor": count / distinct,
   113	        "numpy_version": np.__version__,
   114	        "preprocessing": "collapse whitespace, skip headings, at least five whitespace words",
   115	    }
   116	    receipt.write_text(json.dumps(record, indent=2) + "\n")
   117	    return path, record

