    47	    if kind != "fastembed":
    48	        encode = (
    49	            transformer_contender(threads, repo) if kind == "st" else contender(kind, threads, repo)
    50	        )
    51	        encode.table_dtype = "float32"
    52	        encode.file_bytes = weights_bytes(pinned_snapshot(repo))
    53	        encode.load_source = "pinned Hub snapshot"
    54	        return encode
    55	    os.environ["RAYON_NUM_THREADS"] = str(threads)
    56	    os.environ["TOKENIZERS_PARALLELISM"] = "false" if threads == 1 else "true"
