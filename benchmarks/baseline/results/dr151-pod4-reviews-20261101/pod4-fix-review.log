    87	def series_contract(done, operations, labels, checks):
    88	    specs = {case_id(*spec): spec for spec in cases()}
    89	    if done["cell"] not in specs:
    90	        raise ValueError("series selector is outside the approved README grid")
    91	    repo, dtype, workers, against = specs[done["cell"]]
    92	    expected = {"fse-a": "fse", "fse-b": "fse"}
    93	    if against:
    94	        expected[against] = against
    95	    if set(labels) != set(expected) or any(r["kind"] != expected[r["label"]] for r in operations):
    96	        raise ValueError("series requires both fse controls and its exact reference backend")
    97	    checked = checks[done["cell"]]
    98	    if (checked["model"], checked["table_dtype"], checked["workers"]) != (repo, dtype, workers):
    99	        raise ValueError("output checks differ from the exact approved series selector")
   100	    return checked
