    20	def transformer_contender(threads: int, repo: str):
    21	    os.environ["TOKENIZERS_PARALLELISM"] = "false" if threads == 1 else "true"
    22	    import torch
    23	    from sentence_transformers import SentenceTransformer
    24	
    25	    torch.set_num_threads(threads)
    26	    model = SentenceTransformer(str(pinned_snapshot(repo)), device="cpu")
    27	    batch_size = 32 if repo.endswith("all-MiniLM-L6-v2") else 1024
    28	
    29	    def encode(batch):
    30	        return model.encode(batch, batch_size=batch_size)
    31	
    32	    encode.batch_size = batch_size
    33	    encode.torch_num_threads = torch.get_num_threads()
    34	    return encode
