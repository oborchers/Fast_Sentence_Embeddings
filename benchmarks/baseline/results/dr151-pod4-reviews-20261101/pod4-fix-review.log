   253	        batch_args: tuple[Any, ...] = (),
   254	    ) -> tuple[list[Any], bool]:
   255	        """Shared truncation, batching, and multiprocessing dispatch logic for `encode` and `encode_as_sequence`.
   256	
   257	        :param sentences: The sentence or sentences to encode.
   258	        :param max_length: The maximum length of the sentences. Any tokens beyond this length are truncated.
   259	        :param batch_size: The batch size to use.
   260	        :param show_progress_bar: Whether to show the progress bar.
   261	        :param use_multiprocessing: Whether to use multiprocessing.
   262	        :param multiprocessing_threshold: The threshold in number of sentences for using multiprocessing.
   263	        :param batch_fn: The function to apply to each batch of sentences.
   264	        :param batch_args: Additional positional arguments passed to `batch_fn` after the batch.
   265	        :return: A tuple of the per-batch results and whether the input was a single sentence.
   266	        """
   267	        was_single = False
   268	        if isinstance(sentences, str):
   269	            sentences = [sentences]
   270	            was_single = True
   271	        if max_length is not None:
   272	            m = max_length * self.median_token_length
   273	            sentences = [sentence[:m] for sentence in sentences]
   274	
   275	        sentence_batches = list(self._batch(sentences, batch_size))
   276	        total_batches = math.ceil(len(sentences) / batch_size)
   277	
   278	        self._set_max_length_in_tokenizer(max_length)
   279	        try:
   280	            if use_multiprocessing and len(sentences) > multiprocessing_threshold:
   281	                # Disable parallelism for tokenizers
   282	                os.environ["TOKENIZERS_PARALLELISM"] = "false"
   283	
   284	                results = ProgressParallel(
   285	                    n_jobs=-1, backend="threading", use_tqdm=show_progress_bar, total=total_batches
   286	                )(delayed(batch_fn)(batch, *batch_args) for batch in sentence_batches)
   287	            else:
   288	                results = [
   289	                    batch_fn(batch, *batch_args)
   290	                    for batch in tqdm(sentence_batches, total=total_batches, disable=not show_progress_bar)
   291	                ]
   292	        finally:
   293	            self._set_max_length_in_tokenizer(self.max_length)
   294	
   295	        return results, was_single
