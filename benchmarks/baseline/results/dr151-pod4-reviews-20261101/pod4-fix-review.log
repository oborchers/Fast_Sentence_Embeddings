    25	def command(options, repo, dtype, workers, kind):
    26	    return [
    27	        sys.executable,
    28	        __file__,
    29	        "--kind",
    30	        kind,
    31	        "--threads",
    32	        str(workers),
    33	        "--model",
    34	        repo,
    35	        "--table-dtype",
    36	        dtype,
