    86	def measure(predict, rows, passes=3):
    87	    start = time.perf_counter()
    88	    expected = predict(rows)
    89	    first = time.perf_counter() - start
    90	    durations = []
    91	    for _ in range(passes):
    92	        start = time.perf_counter()
    93	        observed = predict(rows)
