    40	def median(histogram):
    41	    n = sum(histogram.values())
    42	    targets = ((n - 1) // 2, n // 2)
    43	    found, seen = [], 0
    44	    for value, count in sorted(histogram.items()):
    45	        found.extend(value for target in targets if seen <= target < seen + count)
    46	        seen += count
    47	    return sum(found) / 2 if found else None
