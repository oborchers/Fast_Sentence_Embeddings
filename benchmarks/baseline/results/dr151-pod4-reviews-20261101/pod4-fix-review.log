    35	def fitted_head(suite, features, labels):
    36	    from prepare_setfit import fit
    37	    from sklearn.linear_model import LogisticRegression
    38	
    39	    if suite == "setfit":
    40	        return fit(features, labels)
    41	    return LogisticRegression(max_iter=1000, random_state=0).fit(features, labels)
