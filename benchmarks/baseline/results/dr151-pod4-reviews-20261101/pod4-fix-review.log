    22	def expanded_input(folder, texts, labels, requested):
    23	    if not texts or len(texts) != len(labels):
    24	        raise ValueError("held-out texts and labels must have equal nonzero lengths")
    25	    count = math.ceil(requested / len(texts)) * len(texts)
    26	    if count > 10_000_000:
    27	        raise MemoryError("classification input exceeds ten million complete held-out copies")
    28	    path = folder / "pipeline-inputs" / f"timing-{count}-seed0.jsonl"
    29	    receipt = path.with_suffix(".identity.json")
    30	    if receipt.exists():
    31	        return receipt, json.loads(receipt.read_text())
    32	    import shutil
    33	
    34	    expected = count * (sum(len(text.encode("utf-8")) + 40 for text in texts) / len(texts))
    35	    if shutil.disk_usage(folder).free < expected + 25 * 1024**3:
    36	        raise OSError("timing repetitions would leave less than 25 GiB free")
    37	    from pod4_memory import admit
    38	
    39	    admit(count * 24, "classification repetition index workspace")
    40	    indices = np.arange(count, dtype=np.int64) % len(texts)
    41	    np.random.default_rng(0).shuffle(indices)
    42	    with path.open("x", encoding="utf-8") as stream:
    43	        for index in indices:
    44	            stream.write(
    45	                json.dumps({"text": texts[int(index)], "label": int(labels[int(index)])}) + "\n"
    46	            )
    47	    record = {
    48	        "file": str(path.relative_to(folder)),
    49	        "checksum": file_digest(path),
    50	        "rows": count,
    51	        "input_digest": digest(texts[int(index)] for index in indices),
    52	        "label": "balanced repetitions of the complete held-out split, shuffled for inference only",
    53	        "seed": 0,
    54	        "numpy_version": np.__version__,
    55	        "source_rows": len(texts),
    56	        "repetition_factor": count // len(texts),
    57	        "accuracy_scope": "original complete held-out accuracy remains in the training manifest",
    58	    }
    59	    receipt.write_text(json.dumps(record, indent=2) + "\n")
    60	    return receipt, record
