     1	"""Build the locked Rust comparison worker and bind its binary to build inputs."""
     2	
     3	from __future__ import annotations
     4	
     5	import argparse
     6	import json
     7	import subprocess
     8	from pathlib import Path
     9	
    10	from compare_artifacts import file_digest
    11	from quality_coordination import task_reservation
    12	
    13	ROOT = Path(__file__).resolve().parent / "compare_rust"
    14	BINARY = ROOT / "target/release/fse-model2vec-rs-compare"
    15	MANIFEST = BINARY.with_name("build-identity.json")
    16	
    17	
    18	def build_inputs() -> dict:
    19	    paths = [ROOT / "Cargo.toml", ROOT / "Cargo.lock", *sorted((ROOT / "src").rglob("*.rs"))]
    20	    return {str(path.relative_to(ROOT)): file_digest(path) for path in paths}
    21	
    22	
    23	def verified_binary() -> tuple[Path, dict]:
    24	    record = json.loads(MANIFEST.read_text())
    25	    if record["inputs"] != build_inputs() or record["binary_digest"] != file_digest(BINARY):
    26	        raise ValueError("Rust worker differs from its recorded locked build; rebuild it")
    27	    return BINARY, record
    28	
    29	
    30	def build_worker() -> None:
    31	    inputs = build_inputs()
    32	    subprocess.run(["cargo", "build", "--release", "--locked"], cwd=ROOT, check=True)
    33	    if inputs != build_inputs():
    34	        raise ValueError("Rust sources changed during the build")
    35	    record = {
    36	        "inputs": inputs,
    37	        "binary_digest": file_digest(BINARY),
    38	        "rustc": subprocess.check_output(["rustc", "--version"], text=True).strip(),
    39	        "command": ["cargo", "build", "--release", "--locked"],
    40	    }
    41	    MANIFEST.write_text(json.dumps(record, indent=2) + "\n")
    42	
    43	
    44	def main():
    45	    parser = argparse.ArgumentParser(description=__doc__)
    46	    parser.add_argument("--coordination", type=Path, required=True)
    47	    args = parser.parse_args()
    48	    with task_reservation(args.coordination):
    49	        build_worker()
    50	
    51	
    52	if __name__ == "__main__":
    53	    main()
