    17	def emit(name: str, value) -> None:
    18	    raw = json.dumps(value, separators=(",", ":"), ensure_ascii=True).encode()
    19	    zipped = gzip.compress(raw, mtime=0)
    20	    encoded = base64.b64encode(zipped).decode()
    21	    chunks = [encoded[i : i + 160] for i in range(0, len(encoded), 160)]
    22	    print(f"DR190_BEGIN {name} {len(zipped)} {hashlib.sha256(zipped).hexdigest()}", flush=True)
    23	    for index, chunk in enumerate(chunks):
    24	        print(f"DR190_DATA {name} {index} {chunk}", flush=True)
    25	    print(f"DR190_END {name} {len(chunks)}", flush=True)
    26	
    27	
    28	def environment() -> dict:
    29	    data = json.loads(subprocess.check_output(["/usr/bin/lscpu", "--json"], text=True))
    30	    cpu = {row["field"].rstrip(":"): row["data"] for row in data["lscpu"]}
    31	    return {
    32	        "platform": platform.platform(),
    33	        "cpu": cpu.get("Model name", platform.processor()),
    34	        "cpu_details": cpu,
    35	        "python": sys.version,
    36	        "packages": {d.metadata["Name"]: d.version for d in distributions()},
    37	        "affinity": sorted(os.sched_getaffinity(0)),
    38	        "cpu_quota": Path("/sys/fs/cgroup/cpu.max").read_text().strip()
    39	        if Path("/sys/fs/cgroup/cpu.max").exists()
    40	        else None,
    41	        "memory_limit": Path("/sys/fs/cgroup/memory.max").read_text().strip()
    42	        if Path("/sys/fs/cgroup/memory.max").exists()
    43	        else None,
    44	    }
