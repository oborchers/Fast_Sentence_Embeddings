   126	    failed = False
   127	    labels = list(commands)
   128	    for attempt in range(1000 if minimum_seconds else 9):
   129	        if time.monotonic() >= deadline:
   130	            break
   131	        ordered = labels[attempt % len(labels) :] + labels[: attempt % len(labels)]
   132	        context = {"series_id": identifier, "cell": cell, "round": attempt}
   133	        try:
   134	            good, band = round_observation(
   135	                commands, ordered, workers, deadline, output, context, hardware
   136	            )
   137	            ratios.append(band["aa_max_ratio"])
   138	            controls.extend(band["control_seconds"])
   139	            valid += good
   140	        except (RuntimeError, TimeoutError, subprocess.TimeoutExpired) as error:
   141	            failed = True
   142	            append(
   143	                output / "speed-results.jsonl",
