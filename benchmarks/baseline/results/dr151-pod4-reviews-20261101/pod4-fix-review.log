   142	def document(raw, checked_rows, commit, journal):
   143	    checks = {row["cell"]: row for row in checked_rows}
   144	    if len(checks) != len(checked_rows):
   145	        raise ValueError("ambiguous repeated output checks for one cell")
   146	    groups = {}
   147	    for row in raw:
   148	        groups.setdefault(row.get("series_id"), []).append(row)
   149	    result = {
   150	        "format": "readme-speed-panels-v1",
   151	        "selection_rows": [],
   152	        "table": [],
   153	        "comparisons": [],
   154	        "excluded": [],
   155	        "independent_source_review_required": True,
   156	        "table_caption": "",
   157	        "comparison_caption": "",
   158	    }
   159	    for done in (r for r in raw if r.get("event") == "series_complete"):
   160	        try:
   161	            summary, primary, references = extract_series(
   162	                done, groups[done["series_id"]], checks, commit, journal
   163	            )
   164	        except (KeyError, ValueError, ZeroDivisionError) as error:
   165	            result["excluded"].append(
   166	                {"cell": done["cell"], "series_id": done["series_id"], "reason": str(error)}
   167	            )
   168	            continue
   169	        add_cell(result, summary, primary, references)
