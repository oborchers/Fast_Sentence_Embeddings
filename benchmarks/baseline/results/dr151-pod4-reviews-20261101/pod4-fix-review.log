    59	def save_linear(encoder, fitted, folder):
    60	    import joblib
    61	
    62	    import fse
    63	
    64	    model = fse.Classifier.from_sklearn(encoder, fitted, normalized=False)
    65	    if model.normalized:
    66	        raise ValueError("folded classifier must read raw, unnormalized means")
    67	    encoder.save(folder / "raw-encoder.safetensors")
    68	    np.savez(
    69	        folder / "linear-head.npz",
    70	        weight=model.coef_,
    71	        bias=model.intercept_,
    72	        classes=model.classes_,
    73	    )
    74	    # Export the same coefficients through sklearn, rounded once to fse's float32 head.
    75	    fitted.coef_ = model.coef_
    76	    fitted.intercept_ = model.intercept_
    77	    fitted.classes_ = model.classes_
    78	    joblib.dump(fitted, folder / "same-sklearn-head.joblib")
    79	    model.save(folder / "folded-linear.safetensors", standalone=True)
    80	    loaded = fse.Classifier.load(folder / "folded-linear.safetensors", mmap=True)
    81	    if not loaded.standalone or loaded.normalized:
