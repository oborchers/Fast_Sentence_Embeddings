   437	    def _encode_helper(self, id_list: list[int]) -> np.ndarray:
   438	        """Helper function to encode a list of ids.
   439	
   440	        This function is used to deduplicate the logic in `encode` and `encode_as_sequence`.
   441	        It retrieves the embeddings for the given list of ids, applying weights if available.
   442	
   443	        :param id_list: A list of token ids.
   444	        :return: The embeddings for the given ids, as a sequence of vectors.
   445	        """
   446	        id_list_remapped: list[int] | np.ndarray
   447	        if self.token_mapping is None:
   448	            id_list_remapped = id_list
   449	        else:
   450	            id_list_remapped = self.token_mapping[id_list]
   451	        emb = self.embedding[id_list_remapped]
   452	        if self.weights is not None:
   453	            emb = emb * self.weights[id_list][:, None]
   454	
   455	        return emb
   456	
   457	    def _encode_batch(self, sentences: Sequence[str], normalize: bool) -> np.ndarray:
   458	        """Encode a batch of sentences."""
   459	        ids = self.tokenize(sentences=sentences)
   460	        dtype = self.embedding.dtype
   461	        if dtype == np.int8:
   462	            dtype = np.dtype(np.float32)
   463	        out = np.zeros((len(ids), self.dim), dtype=dtype)
   464	
   465	        if self.token_mapping is None and self.weights is None:
   466	            buckets: dict[int, list[int]] = defaultdict(list)
   467	            for i, id_list in enumerate(ids):
   468	                if id_list:
   469	                    buckets[len(id_list)].append(i)
   470	            for _, indices in buckets.items():
   471	                id_matrix = np.array([ids[i] for i in indices], dtype=np.int64)
   472	                out[indices] = self.embedding[id_matrix].mean(axis=1)
   473	        else:
   474	            for i, id_list in enumerate(ids):
   475	                if id_list:
   476	                    emb = self._encode_helper(id_list)
   477	                    out[i] = emb.mean(axis=0)
   478	
   479	        if normalize:
   480	            out32 = out.astype(np.float32)
   481	            norm = np.linalg.norm(out32, axis=1, keepdims=True) + 1e-32
   482	            return (out32 / norm).astype(out.dtype)
   483	
   484	        return out
   485	
   486	    @staticmethod
   487	    def _batch(sentences: Sequence[str], batch_size: int) -> Iterator[Sequence[str]]:
   488	        """Batch the sentences into equal-sized."""
   489	        return (sentences[i : i + batch_size] for i in range(0, len(sentences), batch_size))
