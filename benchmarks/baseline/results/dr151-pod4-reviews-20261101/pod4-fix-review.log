    25	def linear_predict(encoder, weight, bias, classes, rows, workers, *, encode_seconds=None):
    26	    start = time.perf_counter() if encode_seconds is not None else None
    27	    vectors = encoder.encode(rows, workers=workers)
    28	    if encode_seconds is not None:
    29	        encode_seconds.append(time.perf_counter() - start)
    30	    logits = vectors @ weight.T + bias
    31	    indices = (logits[:, 0] > 0).astype(np.intp) if logits.shape[1] == 1 else logits.argmax(axis=1)
    32	    return classes[indices]
    33	
