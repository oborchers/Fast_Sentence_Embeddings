    10	
    11	def spread(values):
    12	    return (
    13	        {"median": statistics.median(values), "min": min(values), "max": max(values)}
    14	        if values
    15	        else None
    16	    )
    17	
    18	
    19	def runtime(row):
    20	    keys = ("runtime_package", "runtime_package_version", "package_location", "runtime_fingerprint")
    21	    return {key: row.get(key) for key in keys}
    22	
    23	
    24	def runtime_eligible(row):
    25	    expected = "model2vec" if row["kind"] in ("mlp", "model2vec-linear") else "fse"
    26	    return row.get("runtime_package") == expected and all(runtime(row).values())
    27	
    28	
    29	def head_runtime_stable(rows):
    30	    if rows[0]["kind"] != "model2vec-linear":
    31	        return True
    32	    heads = [row.get("linear_head_runtime") or {} for row in rows]
    33	    valid = all(
    34	        head.get("runtime_package") == "scikit-learn" and all(runtime(head).values())
    35	        for head in heads
    36	    )
    37	    return valid and len({json.dumps(runtime(head), sort_keys=True) for head in heads}) == 1
    38	
    39	
    40	def arm(rows):
    41	    first = rows[0]
    42	    stable = len({json.dumps(runtime(row), sort_keys=True) for row in rows}) == 1
    43	    stable = stable and all(runtime_eligible(row) for row in rows) and head_runtime_stable(rows)
    44	    return {
    45	        "runtime": runtime(first),
    46	        "runtime_stable": stable,
    47	        "predictions_stable": len({row["output_digest"] for row in rows}) == 1,
    48	        "head": first["head"],
    49	        "normalization": first["normalization"],
    50	        "linear_head_runtime": first.get("linear_head_runtime"),
    51	        "linear_head_runtime_stable": head_runtime_stable(rows),
    52	        "texts_per_second": spread([row["texts"] / row["p50_s"] for row in rows]),
    53	        "seconds": spread([row["p50_s"] for row in rows]),
    54	        "accuracy": [row["quality"] for row in rows],
    55	        "peak_rss_bytes": max(row["peak_rss_bytes"] for row in rows),
    56	        "folded_model_file_bytes": first["folded_model_file_bytes"],
    57	        "encoder_plus_head_file_bytes": first["encoder_plus_head_file_bytes"],
    58	    }
    59	
    60	
    61	def paired_speedups(rows, accepted, labels):
    62	    pairs = {
    63	        number: {row["label"]: row for row in rows if row["round"] == number} for number in accepted
    64	    }
    65	    result = {}
    66	    for label in labels:
    67	        if label in ("fse-a", "fse-b"):
    68	            continue
    69	        result[label] = spread(
    70	            [
    71	                pair[label]["p50_s"] / pair["fse-a"]["p50_s"]
    72	                for pair in pairs.values()
    73	                if label in pair
    74	            ]
    75	        )
    76	    return result
    77	
    78	
    79	def complete_rounds(operations, rounds, expected):
    80	    accepted = set()
    81	    for number in {row["round"] for row in rounds if row.get("valid") and row.get("complete")}:
    82	        current = [row for row in operations if row["round"] == number]
    83	        if len(current) == len(expected) and {row["label"] for row in current} == expected:
    84	            accepted.add(number)
    85	    return accepted
    86	
    87	
    88	def evidence(operations, rounds):
    89	    kinds = {row["kind"] for row in operations}
    90	    expected = (
    91	        {"fse-a", "fse-b", "model2vec-mlp"}
    92	        if "mlp" in kinds
    93	        else {"fse-a", "fse-b", "encode-matmul", "model2vec-same-linear"}
    94	    )
    95	    accepted = complete_rounds(operations, rounds, expected)
    96	    times = [row["p50_s"] for row in operations if row["label"] in ("fse-a", "fse-b")]
    97	    positive = bool(times) and all(math.isfinite(value) and value > 0 for value in times)
    98	    ratio = max(times) / min(times) if positive else None
    99	    equal_inputs = len({(row["input_digest"], row["texts"]) for row in operations}) == 1
   100	    return accepted, {
   101	        "complete_rounds": len(accepted),
   102	        "all_control_max_ratio": ratio,
   103	        "symmetric_aa_band": [1 / ratio, ratio] if ratio is not None else None,
   104	        "equal_inputs": equal_inputs,
   105	        "eligible": len(accepted) >= 3 and ratio is not None and ratio <= 1.1 and equal_inputs,
   106	    }
   107	
   108	
   109	def summarize_cell(identifier, completed, operations, rounds):
   110	    accepted, observed = evidence(operations, rounds)
   111	    rows = [row for row in operations if row["round"] in accepted]
   112	    if not rows:
   113	        return {
   114	            "series_id": identifier,
   115	            "cell": completed["cell"],
   116	            "eligible": False,
   117	            "reason": "no valid complete rounds",
   118	            "aa": completed,
   119	            "verified_evidence": observed,
   120	        }
   121	    labels = sorted({row["label"] for row in rows})
   122	    arms = {label: arm([row for row in rows if row["label"] == label]) for label in labels}
   123	    first = rows[0]
   124	    controls = [row for row in operations if row["label"] in ("fse-a", "fse-b")]
   125	    stable_controls = (
   126	        len({row["output_digest"] for row in controls}) == 1
   127	        and len({json.dumps(runtime(row), sort_keys=True) for row in controls}) == 1
   128	    )
   129	    ratios = paired_speedups(rows, accepted, labels)
   130	    eligible = (
   131	        completed["complete"]
   132	        and observed["eligible"]
   133	        and completed.get("valid_rounds") == observed["complete_rounds"]
   134	        and completed.get("aa_max_ratio") is not None
   135	        and math.isclose(
   136	            completed["aa_max_ratio"], observed["all_control_max_ratio"], rel_tol=1e-12
   137	        )
   138	        and stable_controls
   139	        and all(a["runtime_stable"] and a["predictions_stable"] for a in arms.values())
   140	    )
   141	    return {
   142	        "series_id": identifier,
   143	        "cell": completed["cell"],
   144	        "eligible": eligible,
   145	        "source_commit": first["commit"],
   146	        "dataset": first["dataset"],
   147	        "suite": first["suite"],
   148	        "dataset_revision": first["training_record"]["dataset_revision"],
   149	        "model": first["model"],
   150	        "revision": first["revision"],
   151	        "table_dtype": "float32",
   152	        "requested_workers": first["requested_workers"],
   153	        "texts": first["texts"],
   154	        "input_digest": first["input_digest"],
   155	        "machine": first["machine"],
   156	        "cpu": first["cpu"],
   157	        "dates_utc": sorted({row["time_utc"][:10] for row in rows}),
   158	        "primary_fse_summary": "fse-a; fse-b reported separately",
   159	        "arms": arms,
   160	        "paired_fse_folded_speedup_vs_counterpart": ratios,
   161	        "aa": completed,
   162	        "verified_evidence": observed,
   163	        "control_predictions_stable": stable_controls,
   164	        "note": "fine-tuned Model2Vec MLP is a different trained model; model2vec-same-linear uses the same sklearn coefficients",
   165	    }
   166	
   167	
   168	def summarize(rows):
   169	    result = []
   170	    for done in rows:
   171	        if done.get("event") != "series_complete":
   172	            continue
   173	        identifier = done["series_id"]
   174	        current = [row for row in rows if row.get("series_id") == identifier]
   175	        operations = [row for row in current if row.get("event") == "operation"]
   176	        rounds = [row for row in current if row.get("event") == "round_complete"]
   177	        result.append(summarize_cell(identifier, done, operations, rounds))
   178	    return {"format": "classifier-folding-summary-v1", "cells": result}
   179	
   180	
   181	def publish_summary(folder: Path):
   182	    source = folder / "speed-results.jsonl"
   183	    rows = [json.loads(line) for line in source.read_text().splitlines()]
   184	    result = summarize(rows)
   185	    (folder / "classification-summary.json").write_text(json.dumps(result, indent=2) + "\n")
   186	    emit("classification-summary-" + str(len(result["cells"])), result)
