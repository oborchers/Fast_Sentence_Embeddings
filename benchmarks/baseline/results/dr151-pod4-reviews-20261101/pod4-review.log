    45	def common_context(rows, checked):
    46	    first = rows[0]
    47	    keys = (
    48	        "model",
    49	        "revision",
    50	        "input_digest",
    51	        "texts",
    52	        "corpus",
    53	        "machine",
    54	        "commit",
    55	        "requested_threads",
    56	        "output_dtype",
    57	        "table_dtype",
    58	    )
    59	    stable = all(
    60	        len({json.dumps(row.get(key), sort_keys=True) for row in rows}) == 1 for key in keys
    61	    )
    62	    stable = (
    63	        stable
    64	        and first["input_digest"] == checked["input_digest"]
    65	        and first["model"] == checked["model"]
    66	        and first["revision"] == checked["revision"]
    67	        and first["requested_threads"] == checked["workers"]
    68	        and first["output_dtype"] == checked["output_dtype"]
    69	        and first["table_dtype"] == checked["table_dtype"]
    70	    )
    71	    stable = stable and all(row["shape"] == checked["shape"] for row in rows)
    72	    stable = stable and len({row["time_utc"][:10] for row in rows}) == 1
    73	    stable = stable and all(
    74	        row.get("encoder_fingerprint") == checked["records"]["fse"].get("encoder_fingerprint")
    75	        for row in rows
    76	        if row["kind"] == "fse"
    77	    )
    78	    return stable
