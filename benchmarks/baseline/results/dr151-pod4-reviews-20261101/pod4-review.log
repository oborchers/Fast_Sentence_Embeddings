    67	class Hasher:
    68	    """An incremental checksum of the bytes fed to ``update``, in order."""
    69	
    70	    __slots__ = ("_state",)
    71	
    72	    def __init__(self):
    73	        self._state = xxhash.xxh3_128()
    74	
    75	    def update(self, data: object):
    76	        self._state.update(_buffer(data))
    77	
    78	    def checksum(self) -> str:
    79	        """The checksum of everything fed so far; more data may follow."""
    80	        return PREFIX + self._state.hexdigest()
    81	
    82	
    83	def checksum(data: object) -> str:
    84	    """The checksum of ``data`` (see ``Hasher.update`` for what it takes)."""
    85	    hasher = Hasher()
    86	    hasher.update(data)
    87	    return hasher.checksum()
    88	
    89	
    90	#: The checksum of no bytes: that of every tensor without elements.
    91	EMPTY = checksum(b"")
    92	
    93	
    94	def classify(value: object) -> Literal["ok", "legacy", "unknown", "malformed"]:
    95	    """Whether ``value`` is a checksum of this format, a sha256 one of the pre-release
    96	    format, one of another algorithm, or none at all."""
    97	    if not isinstance(value, str):
    98	        return "malformed"
    99	    if _VALUE.fullmatch(value):
   100	        return "ok"
   101	    if _LEGACY.fullmatch(value):
   102	        return "legacy"
   103	    if _OTHER.fullmatch(value):
   104	        return "unknown"
   105	    return "malformed"
