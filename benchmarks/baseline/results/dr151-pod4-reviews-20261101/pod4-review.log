     1	#!/usr/bin/env python
     2	
     3	# Author: Oliver Borchers
     4	# Copyright (C) Oliver Borchers
     5	# SPDX-License-Identifier: MIT
     6	
     7	"""fse against model2vec or sentence-transformers end to end: the same texts, the same
     8	model, the same vectors.
     9	
    10	Contenders: ``Encoder.encode`` of the model converted by ``Encoder.from_pretrained``
    11	(workers 1 and N) against ``StaticModel.encode`` of model2vec (without its threads, and
    12	with them: ``use_multiprocessing``, which model2vec runs in threads with the parallelism
    13	of tokenizers off), or with ``--against st`` against ``SentenceTransformer.encode`` of
    14	sentence-transformers on the CPU (torch with 1 and N threads, batch size 1024). Each keeps
    15	its library's rules. Every round runs each contender in a fresh process, in alternating
    16	order, for five passes of which the fastest counts, and reports the median of the
    17	rounds. Before the rounds, the vectors of both are compared on the corpus (the largest
    18	difference of a value and the smallest cosine).
    19	
    20	The model (minishlab/potion-base-8M by default, or the --model) and the texts (the
    21	non-empty lines of WikiText-103 validation and test, and the MASSIVE intent test set)
    22	come from the local Hugging Face cache; nothing is downloaded.
    23	
    24	    uv run --with pyarrow python benchmarks/bench_model2vec.py --rounds 3
    25	    uv run --with pyarrow python benchmarks/bench_model2vec.py --against st \
    26	        --model sentence-transformers/static-retrieval-mrl-en-v1
    27	    uv run --with pyarrow python benchmarks/bench_model2vec.py _child fse 1 wikitext 5
    28	
    29	The last form runs one contender and prints its seconds per pass, for the profilers.
    30	"""
    31	
    32	from __future__ import annotations
    33	
    34	import argparse
    35	import json
    36	import os
    37	import platform
    38	import statistics
    39	import sys
    40	import time
    41	from pathlib import Path
    42	
    43	import bench_harness as harness
    44	import numpy as np
    45	
    46	MODEL = "minishlab/potion-base-8M"
    47	PASSES = 5
    48	CORPORA = ("wikitext", "massive")
    49	
    50	
    51	def texts(corpus: str) -> list[str]:
    52	    """The corpora of benchmarks/bench_wordpiece.py."""
    53	    sys.path.insert(0, str(Path(__file__).parent))
    54	    from bench_wordpiece import texts as read
    55	
    56	    return read(corpus)
    57	
    58	
    59	def _revision(repo: str) -> str | None:
    60	    """The commit of a model of the network tests (their cache has no refs/main)."""
    61	    sys.path.insert(0, str(Path(__file__).parent))
    62	    from bench_pretrained import COMMITS
    63	
    64	    return COMMITS.get(repo)
    65	
    66	
    67	def _snapshot(repo: str) -> Path:
    68	    from compare_snapshots import cached_snapshot
    69	
    70	    return cached_snapshot(repo, _revision(repo))
    71	
    72	
    73	def contender(kind: str, threads: int, repo: str):
    74	    """A function from texts to rows."""
    75	    if kind == "fse":
    76	        from fse import Encoder
    77	
    78	        encoder = Encoder.from_pretrained(repo, revision=_revision(repo), local_files_only=True)
    79	        return lambda batch: encoder.encode(batch, workers=threads)
    80	    # model2vec runs its own threads; sentence-transformers leaves N threads to torch and
    81	    # tokenizers.
    82	    os.environ["TOKENIZERS_PARALLELISM"] = "true" if kind == "st" and threads > 1 else "false"
    83	    if kind == "st":
    84	        import torch
    85	        from sentence_transformers import SentenceTransformer
    86	
    87	        torch.set_num_threads(threads)
    88	        model = SentenceTransformer(str(_snapshot(repo)), device="cpu")
    89	        return lambda batch: model.encode(batch, batch_size=1024)
    90	    from model2vec import StaticModel
    91	
    92	    model = StaticModel.from_pretrained(_snapshot(repo))
    93	    return lambda batch: model.encode(batch, use_multiprocessing=threads > 1)
    94	
    95	
    96	def child(kind: str, threads: int, corpus: str, repeats: int, repo: str = MODEL) -> None:
    97	    encode = contender(kind, threads, repo)
    98	    sentences = texts(corpus)
    99	    seconds = []
   100	    for _ in range(repeats):
   101	        start = time.perf_counter()
   102	        encode(sentences)
   103	        seconds.append(time.perf_counter() - start)
   104	    print(json.dumps({"seconds": seconds, "texts": len(sentences)}))
   105	
   106	
   107	def compare(corpus: str, repo: str, against: str) -> tuple[float, float]:
   108	    """The largest difference of a value and the smallest cosine of the two encoders."""
   109	    sentences = texts(corpus)
   110	    a = contender("fse", 1, repo)(sentences).astype(np.float64)
   111	    b = contender(against, 1, repo)(sentences).astype(np.float64)
   112	    keep = np.linalg.norm(b, axis=1) > 0
   113	    cosine = (
   114	        (a[keep] * b[keep]).sum(axis=1)
   115	        / np.linalg.norm(a[keep], axis=1)
   116	        / np.linalg.norm(b[keep], axis=1)
   117	    )
   118	    return float(np.abs(a - b).max()), float(cosine.min())
   119	
   120	
   121	def _child_command(kind: str, threads: int, corpus: str, repo: str) -> list[str]:
   122	    return [sys.executable, __file__, "_child", kind, str(threads), corpus, str(PASSES), repo]
   123	
   124	
   125	def _rounds(contenders, corpus: str, repo: str, n: int) -> list[dict]:
   126	    """``n`` rounds of every contender in alternating order (the first round starts with
   127	    the first); the whole stdout of a child is its JSON."""
