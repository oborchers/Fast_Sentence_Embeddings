   111	def summarize(done, operations, rounds, labels, checked):
   112	    accepted = complete_rounds(operations, rounds, set(labels))
   113	    rows = sorted(
   114	        [row for row in operations if row["round"] in accepted], key=lambda row: row["round"]
   115	    )
   116	    arms = (
   117	        {label: arm([row for row in rows if row["label"] == label], checked) for label in labels}
   118	        if rows
   119	        else {}
   120	    )
   121	    ratio, control_match = aa(operations)
   122	    good = eligible(done, checked, accepted, ratio, control_match, rows, arms)
   123	    result = {
   124	        "cell": done["cell"],
   125	        "series_id": done["series_id"],
   126	        "eligible": good,
   127	        "aa": done,
   128	        "verified_aa_ratio": ratio,
   129	        "symmetric_aa_band": [1 / ratio, ratio] if ratio else None,
   130	        "accepted_rounds": sorted(accepted),
   131	        "arms": arms,
   132	        "output_checked": checked,
   133	        "primary_summary": "fse-a; fse-b separate",
   134	        "publication_commit": None,
   135	        "note": "Raw rows must be committed and independently audited before filling the README renderer input.",
   136	    }
   137	    result.update(measurement_fields(rows, labels))
   138	    return result
