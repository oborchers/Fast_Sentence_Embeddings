    21	
    22	def expanded_input(folder, texts, labels, requested):
    23	    if not texts or len(texts) != len(labels):
    24	        raise ValueError("held-out texts and labels must have equal nonzero lengths")
    25	    count = math.ceil(requested / len(texts)) * len(texts)
    26	    if count > 10_000_000:
    27	        raise MemoryError("classification input exceeds ten million complete held-out copies")
    28	    path = folder / "pipeline-inputs" / f"timing-{count}-seed0.jsonl"
    29	    receipt = path.with_suffix(".identity.json")
    30	    if receipt.exists():
    31	        return receipt, json.loads(receipt.read_text())
    32	    import shutil
    33	
    34	    expected = count * (sum(len(text.encode("utf-8")) + 40 for text in texts) / len(texts))
    35	    if shutil.disk_usage(folder).free < expected + 25 * 1024**3:
    36	        raise OSError("timing repetitions would leave less than 25 GiB free")
    37	    indices = np.arange(count, dtype=np.int64) % len(texts)
    38	    np.random.default_rng(0).shuffle(indices)
    39	    with path.open("x", encoding="utf-8") as stream:
    40	        for index in indices:
    41	            stream.write(
    42	                json.dumps({"text": texts[int(index)], "label": int(labels[int(index)])}) + "\n"
    43	            )
    44	    record = {
    45	        "file": str(path.relative_to(folder)),
    46	        "checksum": file_digest(path),
    47	        "rows": count,
    48	        "input_digest": digest(texts[int(index)] for index in indices),
    49	        "label": "balanced repetitions of the complete held-out split, shuffled for inference only",
    50	        "seed": 0,
    51	        "numpy_version": np.__version__,
    52	        "source_rows": len(texts),
    53	        "repetition_factor": count // len(texts),
    54	        "accuracy_scope": "original complete held-out accuracy remains in the training manifest",
    55	    }
    56	    receipt.write_text(json.dumps(record, indent=2) + "\n")
    57	    return receipt, record
    58	
    59	
    60	def command(folder, workers, kind, receipt, passes=3):
    61	    return [
    62	        sys.executable,
    63	        str(Path(__file__).with_name("pod_folded_child.py")),
    64	        "--folder",
    65	        str(folder),
    66	        "--workers",
    67	        str(workers),
    68	        "--kind",
    69	        kind,
    70	        "--evaluation-record",
    71	        str(receipt),
    72	        "--minimum-seconds",
    73	        "2",
    74	        "--passes",
    75	        str(passes),
    76	    ]
    77	
    78	
    79	def calibrate(args, folder, texts, labels, workers):
    80	    requested = max(len(texts), 100_000)
    81	    while True:
    82	        receipt, record = expanded_input(folder, texts, labels, requested)
    83	        done = subprocess.run(
    84	            command(folder, workers, "folded", receipt, 1),
    85	            capture_output=True,
    86	            text=True,
    87	            check=False,
    88	            env=child_environment(workers),
    89	            timeout=max(0.01, args.deadline - time.monotonic()),
    90	        )
    91	        if done.returncode:
    92	            append(
    93	                args.output / "calibration.jsonl",
    94	                {"status": "failed", "stderr": done.stderr[-12000:]},
    95	            )
    96	            raise RuntimeError("folded-classifier calibration failed")
    97	        row = json.loads(done.stdout.strip().splitlines()[-1])
    98	        append(
    99	            args.output / "calibration.jsonl", {"scope": "input sizing only", "measurement": row}
   100	        )
   101	        smallest = min(row["first_predict_s"], *row["warm_seconds"])
   102	        if smallest >= 2.5:
   103	            return receipt, record
   104	        if not math.isfinite(smallest) or smallest <= 0:
   105	            raise ValueError("nonpositive classification calibration duration")
   106	        requested = math.ceil(record["rows"] * 2.5 / smallest * 1.1)
   107	
   108	
   109	def timed(args, folder, texts, labels, suite, name):
   110	    failed = []
   111	    for workers in (1, 32):
   112	        receipt, _ = calibrate(args, folder, texts, labels, workers)
   113	        base = {label: command(folder, workers, "folded", receipt) for label in ("fse-a", "fse-b")}
   114	        pairs = {
   115	            "same-linear-head": {
   116	                "encode-matmul": command(folder, workers, "encode-matmul", receipt),
   117	                "model2vec-same-linear": command(folder, workers, "model2vec-linear", receipt),
   118	            },
   119	            "mlp": {"model2vec-mlp": command(folder, workers, "mlp", receipt)},
   120	        }
   121	        for label, references in pairs.items():
   122	            cell = f"folded/{suite}/{name}/{workers}/{label}"
   123	            done = series({**base, **references}, workers, args.output, args.deadline, cell)
   124	            if not done["complete"]:
   125	                failed.append(cell)
   126	    from pod_folded_summary import publish_summary
   127	
   128	    publish_summary(args.output)
   129	    if failed:
   130	        raise RuntimeError("classification has short, failed or noisy cells: " + ", ".join(failed))
   131	
   132	
   133	def dataset(args, suite, name, data, provenance):
   134	    folder = args.output / (suite + "-" + name)
   135	    manifest = folder / "manifest.json"
   136	    record = (
   137	        json.loads(manifest.read_text())
   138	        if manifest.exists()
   139	        else prepare(suite, name, data, provenance, folder)
   140	    )
   141	    if "mlp" not in record:
   142	        record = prepare_mlp(data, provenance, folder, record)
   143	    append(args.output / "classification-quality.jsonl", {**record, **args.hardware})
   144	    emit("pod4-prepared-" + suite + "-" + name, record)
   145	    timed(args, folder, data[2], data[3], suite, name)
   146	
   147	
   148	def run(args):
   149	    import torch
   150	    from huggingface_hub import snapshot_download
   151	
   152	    snapshot_download(
   153	        REPO,
   154	        revision=MODELS[REPO],
   155	        allow_patterns=["*.json", "*.safetensors", "README.md"],
   156	        max_workers=2,
   157	    )
   158	    torch.set_num_threads(16)
   159	    names = [
   160	        r["dataset"].removeprefix("SetFit/") for r in json.loads(SOURCES.read_text())["datasets"]
   161	    ]
   162	    selected = ["ag_news", "subj", *[name for name in names if name not in ("ag_news", "subj")]]
   163	    order = [("setfit", selected), ("fineweb", None)]
   164	    failed = []
   165	    for suite, selection in order:
   166	        for name, data, provenance in inputs(suite, args.cache / suite, selection):
   167	            if time.monotonic() >= args.deadline:
   168	                raise TimeoutError("classification stage deadline reached")
   169	            try:
   170	                dataset(args, suite, name, data, provenance)
   171	            except Exception as error:
   172	                failed.append(suite + "/" + name)
   173	                append(
   174	                    args.output / "invocations.jsonl",
   175	                    {"suite": suite, "dataset": name, "status": "failed", "error": repr(error)},
   176	                )
   177	            del data
   178	    if failed:
   179	        raise RuntimeError("classification datasets failed: " + ", ".join(failed))

