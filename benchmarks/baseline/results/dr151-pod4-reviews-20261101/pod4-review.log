     1	"""Paired static encoder comparison with a shared lock and an fse A/A control.
     2	
     3	Run repeatedly if the machine is busy. Completed and rejected operations are
     4	appended immediately, so an interrupted comparison retains its evidence.
     5	Only complete rounds with every endpoint load strictly below 5 are accepted.
     6	Model setup and corpus reads are outside encode timing, inside the lock.
     7	"""
     8	
     9	from __future__ import annotations
    10	
    11	import argparse
    12	import json
    13	import os
    14	import subprocess
    15	import sys
    16	import time
    17	import uuid
    18	from contextlib import contextmanager
    19	from functools import partial
    20	from pathlib import Path
    21	
    22	import numpy as np
    23	from compare_backends import make_contender as contender
    24	from compare_inputs import corpus_identity, identity, texts
    25	from compare_models import MODELS
    26	from compare_parallelism import child_environment, settings
    27	from compare_runtime import verify_backend_identity
    28	from compare_wait import TimingBudgetExpiredError, TimingDeferredError, ready_operation
    29	
    30	
    31	@contextmanager
    32	def reservation(lock: Path):
    33	    """Reserve one operation, never changing another owner's lock."""
    34	    marker = lock.parent / "pause-local.marker"
    35	    if marker.exists() or os.getloadavg()[0] >= 5:
    36	        raise TimingDeferredError("timing deferred: paused or load >= 5")
    37	    lock.mkdir()
    38	    owner = lock / "owner"
    39	    identity = f"dr151-compare pid={os.getpid()}"
    40	    try:
    41	        owner.write_text(identity, encoding="utf-8")
    42	        if marker.exists() or os.getloadavg()[0] >= 5:
    43	            raise TimingDeferredError("timing deferred after reservation")
    44	        yield
    45	    finally:
    46	        if owner.exists() and owner.read_text(encoding="utf-8") == identity:
    47	            owner.unlink()
    48	            lock.rmdir()
    49	
    50	
    51	def child(args) -> None:
    52	    sentences = texts(args.corpus)
    53	    original_digest = corpus_identity(args.corpus, sentences)["input_digest"]
    54	    if getattr(args, "canonical_newlines", False):
    55	        sentences = [row.replace("\r", " ").replace("\n", " ") for row in sentences]
    56	    if args.warmup_texts is not None and args.warmup_texts > len(sentences):
    57	        raise ValueError("warmup-texts exceeds the complete corpus size")
    58	    provenance = identity(args.kind)
    59	    if args.kind == "rust":
    60	        from compare_rust_worker import measure
    61	
    62	        record, vectors = measure(args, sentences)
    63	    else:
    64	        from threadpoolctl import threadpool_info, threadpool_limits
    65	
    66	        with threadpool_limits(limits=args.threads):
    67	            record, vectors = python_measure(args, sentences)
    68	            record["threadpools"] = threadpool_info()
    69	    from fse._container._hash import checksum
    70	
    71	    verify_backend_identity(args.kind, provenance)
    72	    measured_commit = subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip()
    73	    if provenance["commit"] != measured_commit:
    74	        raise RuntimeError("source commit changed during the measured operation")
    75	    provenance.update(corpus_identity(args.corpus, sentences))
    76	    if getattr(args, "canonical_newlines", False):
    77	        provenance.update(
    78	            original_input_digest=original_digest,
    79	            preprocessing="CR and LF replaced individually with spaces, no stripping, no dropped rows",
    80	        )
    81	    if args.vectors_out is not None:
    82	        np.save(args.vectors_out, vectors)
    83	    record.update(
    84	        {
    85	            **provenance,
    86	            "time_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    87	            "kind": args.kind,
    88	            **settings(args.kind, args.threads, len(sentences)),
    89	            "model": args.model,
    90	            "revision": MODELS[args.model],
    91	            "corpus": args.corpus,
    92	            "texts": len(sentences),
    93	            "timed_passes": args.passes,
    94	            "output_digest": checksum(np.ascontiguousarray(vectors)),
    95	            "p50_s": float(np.median(record["warm_seconds"])),
    96	            "p95_s": float(np.percentile(record["warm_seconds"], 95)),
    97	        }
    98	    )
    99	    print(json.dumps(record))
