     2	
     3	import json
     4	import subprocess
     5	import tempfile
     6	import time
     7	from pathlib import Path
     8	
     9	import numpy as np
    10	from artifact_manifest import header
    11	from compare_models import artifact_path
    12	from compare_parallelism import child_environment
    13	from compare_runtime import expected_package
    14	from pod_speed import encode_command
    15	
    16	RTOL = 2e-5
    17	ATOL = 2e-6
    18	
    19	
    20	def norm_record(vectors, normalized):
    21	    zero_rows, low, high, error = 0, float("inf"), 0.0, 0.0
    22	    for start in range(0, len(vectors), 8192):
    23	        norms = np.linalg.norm(vectors[start : start + 8192].astype(np.float64), axis=1)
    24	        nonzero = norms > 0
    25	        zero_rows += int((~nonzero).sum())
    26	        if nonzero.any():
    27	            low = min(low, float(norms[nonzero].min()))
    28	            high = max(high, float(norms[nonzero].max()))
    29	            error = max(error, float(np.max(np.abs(norms[nonzero] - 1))))
    30	    if normalized and error > RTOL:
    31	        raise ValueError("output does not follow the declared unit-normalization policy")
    32	    return {
    33	        "zero_rows": zero_rows,
    34	        "nonzero_norm_min": low if low != float("inf") else None,
    35	        "nonzero_norm_max": high if high else None,
    36	        "max_unit_norm_error": error,
    37	    }
    38	
    39	
    40	def compare_blocks(first, vectors):
    41	    difference = 0.0
    42	    for start in range(0, len(first), 8192):
    43	        left, right = first[start : start + 8192], vectors[start : start + 8192]
    44	        if not np.isfinite(right).all():
    45	            raise ValueError("output shape/dtype/finite values differ within a same-model pair")
    46	        if not np.array_equal(np.any(left != 0, axis=1), np.any(right != 0, axis=1)):
    47	            raise ValueError("same-model pair disagrees on empty output rows")
    48	        if not np.allclose(left, right, rtol=RTOL, atol=ATOL):
    49	            raise ValueError("same-model pair differs beyond the disclosed float32 output bound")
    50	        difference = max(difference, float(np.max(np.abs(left.astype(np.float64) - right))))
    51	    return difference
    52	
    53	
    54	def contract(arrays, normalized, expected_texts=5352):
    55	    first = arrays["fse"]
    56	    if first.ndim != 2 or first.shape[0] != expected_texts:
    57	        raise ValueError(f"README checks require all {expected_texts} input rows")
    58	    records = {}
    59	    for label, vectors in arrays.items():
    60	        if vectors.dtype != np.float32 or vectors.shape != first.shape:
    61	            raise ValueError("output shape/dtype/finite values differ within a same-model pair")
    62	        difference = compare_blocks(first, vectors)
    63	        records[label] = {
    64	            **norm_record(vectors, normalized),
    65	            "max_absolute_difference_from_fse": difference,
    66	        }
    67	    return {
    68	        "passed": True,
    69	        "shape": list(first.shape),
    70	        "output_dtype": "float32",
    71	        "normalize": normalized,
    72	        "rtol": RTOL,
    73	        "atol": ATOL,
    74	        "validation_block_rows": 8192,
    75	        "arms": records,
    76	    }
    77	
    78	
    79	def run_vectors(options, repo, dtype, workers, kind, path):
    80	    command = [
    81	        *encode_command(options, repo, dtype, "wikitext", workers, kind),
    82	        "--vectors-out",
    83	        str(path),
    84	    ]
    85	    env = {
    86	        **child_environment(workers),
    87	        "RAYON_NUM_THREADS": str(workers),
    88	        "TOKENIZERS_PARALLELISM": "true" if workers > 1 else "false",
    89	    }
    90	    completed = subprocess.run(
    91	        command,
    92	        check=False,
    93	        capture_output=True,
    94	        text=True,
    95	        timeout=max(0.01, options.deadline - time.monotonic()),
    96	        env=env,
    97	    )
    98	    if completed.returncode:
    99	        raise RuntimeError(f"output check failed ({kind}): {completed.stderr[-3000:]}")
   100	    row = json.loads(completed.stdout.strip().splitlines()[-1])
   101	    if row.get("runtime_package") != expected_package(kind):
   102	        raise ValueError("output check carries the wrong backend identity")
   103	    return row, np.load(path, mmap_mode="r" if getattr(options, "input_file", None) else None)
   104	
   105	
   106	def check(options, repo, dtype, workers, against):
   107	    metadata = header(artifact_path(options.models, repo, dtype))
   108	    normalized = "normalize@1" in json.loads(metadata["fse.steps"])
   109	    parent = options.output / "pipeline-inputs"
   110	    parent.mkdir(exist_ok=True)
   111	    arrays, rows = {}, {}
   112	    with tempfile.TemporaryDirectory(prefix="output-check-", dir=parent) as temporary:
   113	        for kind in ["fse", *([against] if against else [])]:
   114	            rows[kind], arrays[kind] = run_vectors(
   115	                options,
   116	                repo,
   117	                dtype if kind == "fse" else "float32",
   118	                workers,
   119	                kind,
   120	                Path(temporary) / (kind + ".npy"),
   121	            )
   122	        expected = options.input_record["texts"] if getattr(options, "input_file", None) else 5352
   123	        result = contract(arrays, normalized, expected)
   124	        if result["shape"][1] != int(metadata["fse.output_dim"]):
   125	            raise ValueError("output width differs from the bound encoder artifact")
   126	    first = rows["fse"]
   127	    if any(
   128	        row["input_digest"] != first["input_digest"] or row["revision"] != first["revision"]
   129	        for row in rows.values()
   130	    ):
   131	        raise ValueError("output validation does not share the exact model/input revision")
   132	    result.update(
   133	        records=rows,
   134	        encoder_header=metadata,
   135	        model=repo,
   136	        revision=first["revision"],
   137	        input_digest=first["input_digest"],
   138	        table_dtype=dtype,
   139	        workers=workers,
   140	        scope="full-corpus correctness only; these preliminary timings are not published as paired rates",
   141	    )
   142	    return result

