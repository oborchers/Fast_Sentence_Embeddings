   146	def operation(args, label: str, threads: int) -> dict:
   147	    sources = [
   148	        "src",
   149	        "setup.py",
   150	        "pyproject.toml",
   151	        "uv.lock",
   152	        ":(glob)benchmarks/**/*.py",
   153	        "benchmarks/compare_rust/src",
   154	        "benchmarks/compare_rust/Cargo.toml",
   155	        "benchmarks/compare_rust/Cargo.lock",
   156	    ]
   157	    if subprocess.run(["git", "diff", "--quiet", "HEAD", "--", *sources], check=False).returncode:
   158	        raise RuntimeError("timing deferred: tracked worktree changes are not committed")
   159	    kind = "fse" if label.startswith("fse") else args.against
   160	    command = [
   161	        str(args.other_python) if kind != "fse" and args.other_python else sys.executable,
   162	        __file__,
   163	        "child",
   164	        "--kind",
   165	        kind,
   166	        "--threads",
   167	        str(threads),
   168	        "--model",
   169	        args.other_model if kind != "fse" and args.other_model else args.model,
   170	        "--table-dtype",
   171	        args.table_dtype if kind == "fse" else "float32",
   172	        "--corpus",
   173	        args.corpus,
   174	        "--passes",
   175	        str(args.passes),
   176	    ]
   177	    if kind == "fse" and args.fse_models is not None:
   178	        command.extend(["--fse-models", str(args.fse_models)])
   179	    if args.warmup_texts is not None:
   180	        command.extend(["--warmup-texts", str(args.warmup_texts)])
   181	    with reservation(args.lock):
   182	        before = os.getloadavg()[0]
   183	        done = subprocess.run(
   184	            command, text=True, capture_output=True, check=False, env=child_environment(threads)
   185	        )
   186	        after = os.getloadavg()[0]
   187	        if done.returncode:
   188	            raise RuntimeError(f"{label} failed: {done.stderr[-3000:]}")
   189	        result = json.loads(done.stdout.strip().splitlines()[-1])
   190	        return {
   191	            **result,
   192	            "label": label,
   193	            "load_before": before,
   194	            "load_after": after,
   195	            "valid": before < 5 and after < 5,
   196	        }
   197	
