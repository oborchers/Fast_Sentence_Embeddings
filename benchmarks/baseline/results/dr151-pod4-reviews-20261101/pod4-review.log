    26	def settings(kind: str, requested: int, texts: int) -> dict:
    27	    result = {
    28	        "requested_threads": requested,
    29	        "threads": requested if kind == "fse" else None,
    30	        "fse_workers": requested if kind == "fse" else None,
    31	        "tokenizer_thread_count": None,
    32	        "tokenizer_threads_measured": False,
    33	    }
    34	    if kind == "model2vec":
    35	        batch_pool = requested > 1 and texts > 10_000
    36	        result.update(
    37	            {
    38	                "tokenizer_parallelism": "on" if requested > 1 and not batch_pool else "off",
    39	                "parallel_batch_pool": "default" if batch_pool else "disabled",
    40	            }
    41	        )
    42	    return result

