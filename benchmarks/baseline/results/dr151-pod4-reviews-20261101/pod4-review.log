   141	def measurement_fields(rows, labels):
   142	    result = {}
   143	    if rows:
   144	        first = rows[0]
   145	        result["measurement"] = {
   146	            key: first.get(key)
   147	            for key in (
   148	                "commit",
   149	                "model",
   150	                "revision",
   151	                "input_digest",
   152	                "corpus",
   153	                "texts",
   154	                "machine",
   155	                "cpu",
   156	                "python",
   157	                "versions",
   158	                "requested_threads",
   159	                "output_dtype",
   160	                "table_dtype",
   161	            )
   162	        }
   163	        result["dates_utc"] = sorted({row["time_utc"][:10] for row in rows})
   164	        result["paired_speedups"] = {
   165	            label: paired_ratios(rows, label) for label in labels if label not in ("fse-a", "fse-b")
   166	        }
