    21	def hub_model(repo: str, folder: Path, dtypes=("float32",)) -> list[Path]:
    22	    from compare_models import MODELS, artifact_name
    23	
    24	    from fse import Encoder
    25	
    26	    folder.mkdir(parents=True, exist_ok=True)
    27	    paths = [folder / artifact_name(repo, dtype) for dtype in dtypes]
    28	    if any(path.exists() for path in paths):
    29	        raise FileExistsError("preparation refuses existing artifacts")
    30	    encoder = Encoder.from_pretrained(repo, revision=MODELS[repo])
    31	    record = {
    32	        "source": repo,
    33	        "revision": MODELS[repo],
    34	        "recipe": "pinned fse conversion",
    35	        "fit": None,
    36	        "artifacts": [p.name for p in paths],
    37	    }
    38	    parent = encoder.fingerprint
    39	    for dtype, path in zip(dtypes, paths, strict=True):
    40	        current = encoder if dtype == "float32" else encoder.quantize(dtype)
    41	        current.save(path)
    42	        register(folder, path, record, parent)
    43	    return paths
