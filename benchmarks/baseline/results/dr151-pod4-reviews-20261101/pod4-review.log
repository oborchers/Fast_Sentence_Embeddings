     9	def file_digest(path: Path) -> str:
    10	    from fse._container._hash import Hasher
    11	
    12	    hasher = Hasher()
    13	    with path.open("rb") as stream:
    14	        while block := stream.read(8 * 2**20):
    15	            hasher.update(block)
    16	    return hasher.checksum()
    17	
