    44	fn main() -> Result<(), Box<dyn std::error::Error>> {
    45	    let mut args: Vec<String> = env::args().collect();
    46	    let lines = args.get(1).map(String::as_str) == Some("--lines");
    47	    if lines { args.remove(1); }
