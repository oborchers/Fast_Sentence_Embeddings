    25	def linear_predict(encoder, weight, bias, classes, rows, workers):
    26	    vectors = encoder.encode(rows, workers=workers)
    27	    logits = vectors @ weight.T + bias
    28	    indices = (logits[:, 0] > 0).astype(np.intp) if logits.shape[1] == 1 else logits.argmax(axis=1)
    29	    return classes[indices]
