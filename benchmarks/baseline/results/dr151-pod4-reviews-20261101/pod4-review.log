    51	def load_pages(cache: Path, *, download: bool) -> tuple[list[str], np.ndarray]:
    52	    import pyarrow.parquet as pq
    53	    from huggingface_hub import snapshot_download
    54	
    55	    folder = Path(
    56	        snapshot_download(
    57	            REPO,
    58	            repo_type="dataset",
    59	            revision=REVISION,
    60	            cache_dir=cache / "hub",
    61	            allow_patterns=["data/*.parquet"],
    62	            local_files_only=not download,
    63	            max_workers=2,
    64	        )
    65	    )
    66	    pages, scores = [], []
    67	    for number in range(8):
    68	        file = folder / f"data/train-{number:05d}-of-00008.parquet"
    69	        table = pq.read_table(file, columns=["text", "score"]).to_pydict()
    70	        pages.extend(" ".join(text.split()) for text in table["text"])
    71	        scores.extend(table["score"])
    72	    if len(pages) != 467_424 or not all(0 <= score <= 5 for score in scores):
    73	        raise ValueError("unexpected FineWeb annotation count or scores")
    74	    return pages, np.asarray(scores, dtype=np.int8)
