    30	import numpy as np
    31	import xxhash
    32	
    33	ALGORITHM = "xxh3-128"
    34	PREFIX = ALGORITHM + ":"
    35	#: The length of every value, so the safetensors writer can reserve its header.
    36	PLACEHOLDER = PREFIX + "0" * 32
    37	
    38	_VALUE = re.compile(r"xxh3-128:[0-9a-f]{32}")
    39	# The sha256 values of the pre-release 2.0 format: bare checksums and fingerprints.
    40	_LEGACY = re.compile(r"(sha256:)?[0-9a-f]{64}")
    41	# A value of another algorithm: a name that is not ours, a colon and hex digits.
    42	_OTHER = re.compile(r"(?!xxh3-128:|sha256:)[a-z0-9][a-z0-9_-]*:[0-9a-f]+")
    43	
    44	
    45	def _buffer(data: object) -> bytes | bytearray | memoryview:
    46	    """The bytes of ``data``: bytes, bytearray, a C-contiguous memoryview or a C-contiguous
    47	    little-endian (or single-byte) array; anything else raises, whatever xxhash accepts."""
    48	    if isinstance(data, bytes | bytearray):
    49	        return data
    50	    if isinstance(data, memoryview):
    51	        if not data.c_contiguous:
    52	            raise ValueError("only C-contiguous memory can be hashed")
    53	        if data.nbytes == 0:  # cast refuses a shape with a zero
    54	            return b""
    55	        return data.cast("B") if data.format != "B" or data.ndim != 1 else data
    56	    if isinstance(data, np.ndarray):
    57	        if not data.flags.c_contiguous:
    58	            raise ValueError("only C-contiguous arrays can be hashed")
    59	        if data.dtype.hasobject or data.dtype.str[0] == ">":
    60	            raise ValueError(
    61	                f"arrays of {data.dtype.str} cannot be hashed; the format is little-endian"
    62	            )
    63	        return memoryview(data.reshape(-1).view(np.uint8))
    64	    raise TypeError(f"bytes or a numpy array can be hashed, not {type(data).__name__}")
