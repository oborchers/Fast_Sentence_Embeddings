   108	PinKind = Literal["sha256", "git_sha1"]
   109	
   110	
   111	def pin_digest(data: bytes | bytearray | memoryview, kind: PinKind) -> str:
   112	    """The one digest ``kind`` of ``data`` as hex, hashed in place (no copy): the sha256,
   113	    or the git blob sha1 (``sha1(b"blob <size>\\0" + data)``). Exactly one algorithm runs."""
   114	    view = memoryview(data).cast("B")
   115	    if kind == "sha256":
   116	        return hashlib.sha256(view).hexdigest()
   117	    if kind == "git_sha1":
   118	        sha1 = hashlib.sha1(b"blob %d\0" % view.nbytes)  # the id git gives the content
   119	        sha1.update(view)
   120	        return sha1.hexdigest()
   121	    raise ValueError(f"unknown digest kind {kind!r}")
   122	
   123	
   124	def file_digests(handle, size: int, chunk: int = 2**22) -> tuple[str, str]:
   125	    """The sha256 and the git blob sha1 (``sha1(b"blob <size>\\0" + data)``) of the
   126	    ``size`` bytes read from ``handle``, both as hex; raises if the file is shorter."""
   127	    sha256 = hashlib.sha256()
   128	    sha1 = hashlib.sha1(b"blob %d\0" % size)  # the id git gives the content, not security
   129	    remaining = size
   130	    while remaining:
   131	        part = handle.read(min(chunk, remaining))
   132	        if not part:
   133	            raise ValueError(f"the file ended {remaining} bytes early")
   134	        sha256.update(part)
   135	        sha1.update(part)
   136	        remaining -= len(part)
   137	    return sha256.hexdigest(), sha1.hexdigest()
