   102	def python_measure(args, sentences):
   103	    import resource
   104	
   105	    start = time.perf_counter()
   106	    encode = contender(
   107	        args.kind, args.threads, args.model, table_dtype=args.table_dtype, folder=args.fse_models
   108	    )
   109	    load_s = time.perf_counter() - start
   110	    if args.kind == "model2vec" and args.threads > 1:
   111	        # Above its threshold model2vec disables tokenizer parallelism itself.
   112	        os.environ["TOKENIZERS_PARALLELISM"] = "true"
   113	    warmup = sentences if args.warmup_texts is None else sentences[: args.warmup_texts]
   114	    start = time.perf_counter()
   115	    encode(warmup)
   116	    first = time.perf_counter() - start
   117	    durations = []
   118	    for _ in range(args.passes):
   119	        start = time.perf_counter()
   120	        out = encode(sentences)
   121	        durations.append(time.perf_counter() - start)
   122	    return {
   123	        "load_s": load_s,
   124	        "first_encode_s": first,
   125	        "first_encode_texts": len(warmup),
   126	        "warm_seconds": durations,
   127	        "shape": out.shape,
   128	        "peak_rss_bytes": resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
   129	        * (1 if sys.platform == "darwin" else 1024),
   130	        "rss_scope": "Python encoder process",
   131	        "table_dtype": encode.table_dtype if hasattr(encode, "table_dtype") else args.table_dtype,
   132	        "output_dtype": str(out.dtype),
   133	        "file_bytes": encode.file_bytes if hasattr(encode, "file_bytes") else None,
   134	        "load_source": encode.load_source if hasattr(encode, "load_source") else None,
   135	        "encoder_fingerprint": encode.encoder_fingerprint
   136	        if hasattr(encode, "encoder_fingerprint")
   137	        else None,
   138	        "artifact_provenance": getattr(encode, "artifact_provenance", None),
   139	        "batch_size": encode.batch_size if hasattr(encode, "batch_size") else None,
   140	        "torch_num_threads": encode.torch_num_threads
   141	        if hasattr(encode, "torch_num_threads")
   142	        else None,
   143	    }, out
   144	
