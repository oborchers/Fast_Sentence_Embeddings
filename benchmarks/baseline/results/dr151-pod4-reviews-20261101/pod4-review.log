    23	def aa_band(rows):
    24	    controls = [row for row in rows if row["label"] in ("fse-a", "fse-b")]
    25	    if len(controls) != 2 or any(row["p50_s"] <= 0 for row in controls):
    26	        raise ValueError("round needs two positive fse control measurements")
    27	    times = [row["p50_s"] for row in controls]
    28	    ratio = max(times) / min(times)
    29	    return {
    30	        "aa_max_ratio": ratio,
    31	        "symmetric_aa_band": [1 / ratio, ratio],
    32	        "aa_spread_percent": (ratio - 1) * 100,
    33	        "control_seconds": times,
    34	        "noise_label": "within 10% A/A band"
    35	        if ratio <= 1.1
    36	        else "noisy, re-measure in a quiet window",
    37	    }
    38	
    39	
    40	def noise_label(ratio):
    41	    if ratio is None:
    42	        return "unavailable, incomplete"
    43	    if ratio > 1.1:
    44	        return "noisy, re-measure in a quiet window"
    45	    return "within 10% A/A band"
    46	
    47	
    48	def operation(command, label, workers, deadline, output, context, hardware):
    49	    remaining = deadline - time.monotonic()
    50	    if remaining <= 0:
    51	        raise TimeoutError("pod deadline reached")
    52	    before = os.getloadavg()
    53	    started = time.monotonic()
    54	    done = subprocess.run(
    55	        command,
    56	        text=True,
    57	        capture_output=True,
    58	        check=False,
    59	        timeout=remaining,
    60	        env=child_environment(workers),
    61	    )
    62	    append(
    63	        output / "invocations.jsonl",
    64	        {
    65	            **context,
    66	            **hardware,
    67	            "command": command,
    68	            "status": "completed" if done.returncode == 0 else "failed",
    69	            "returncode": done.returncode,
    70	            "seconds": time.monotonic() - started,
    71	            "stderr": done.stderr[-12000:],
    72	        },
    73	    )
    74	    if done.returncode:
    75	        raise RuntimeError(f"child failed ({done.returncode}): {done.stderr[-3000:]}")
    76	    row = json.loads(done.stdout.strip().splitlines()[-1])
    77	    return {
    78	        **row,
    79	        **hardware,
    80	        **context,
    81	        "label": label,
    82	        "event": "operation",
    83	        "load_before": before,
    84	        "load_after": os.getloadavg(),
    85	        "host_load_policy": "recorded, never rejects a shared pod run",
    86	    }
    87	
    88	
    89	def round_observation(commands, ordered, workers, deadline, output, context, hardware):
    90	    rows = []
    91	    for label in ordered:
    92	        row = operation(commands[label], label, workers, deadline, output, context, hardware)
    93	        append(output / "speed-results.jsonl", row)
    94	        rows.append(row)
    95	    band = aa_band(rows)
    96	    equal_inputs = len({row["input_digest"] for row in rows}) == 1
    97	    long_enough = all(qualifies(row) for row in rows if row["label"] in ("fse-a", "fse-b"))
    98	    good = band["aa_max_ratio"] <= 1.1 and equal_inputs and long_enough
    99	    append(
   100	        output / "speed-results.jsonl",
   101	        {
   102	            **context,
   103	            **hardware,
   104	            **band,
   105	            "event": "round_complete",
   106	            "valid": good,
   107	            "complete": True,
   108	            "equal_inputs": equal_inputs,
   109	            "minimum_call_duration_passed": long_enough,
   110	        },
   111	    )
   112	    return good, band
   113	
   114	
   115	def series(commands, workers, output, deadline, cell, *, minimum_seconds=0):
   116	    if sys.platform != "linux":
   117	        raise RuntimeError("pod timing policy is restricted to Linux")
   118	    hardware = environment()
   119	    identifier = uuid.uuid4().hex
   120	    start = time.monotonic()
   121	    valid, ratios, controls = 0, [], []
   122	    failed = False
   123	    labels = list(commands)
   124	    for attempt in range(1000 if minimum_seconds else 9):
   125	        if time.monotonic() >= deadline:
   126	            break
   127	        ordered = labels[attempt % len(labels) :] + labels[: attempt % len(labels)]
   128	        context = {"series_id": identifier, "cell": cell, "round": attempt}
   129	        try:
   130	            good, band = round_observation(
   131	                commands, ordered, workers, deadline, output, context, hardware
   132	            )
   133	            ratios.append(band["aa_max_ratio"])
   134	            controls.extend(band["control_seconds"])
   135	            valid += good
   136	        except (RuntimeError, TimeoutError, subprocess.TimeoutExpired) as error:
   137	            failed = True
   138	            append(
   139	                output / "speed-results.jsonl",
   140	                {
   141	                    **context,
   142	                    **hardware,
   143	                    "event": "round_complete",
   144	                    "valid": False,
   145	                    "complete": False,
   146	                    "reason": repr(error),
   147	                },
   148	            )
   149	            break
   150	        if valid >= 3 and time.monotonic() - start >= minimum_seconds:
   151	            break
   152	    # Probe rejection uses every observed A/A round, including noisy rounds.
   153	    elapsed = time.monotonic() - start
   154	    control_ratio = max(controls) / min(controls) if controls else None
   155	    result = {
   156	        "event": "series_complete",
   157	        "series_id": identifier,
   158	        "cell": cell,
   159	        "valid_rounds": valid,
   160	        "required_rounds": 3,
   161	        "complete": not failed
   162	        and valid >= 3
   163	        and bool(ratios)
   164	        and max(ratios) <= 1.1
   165	        and control_ratio <= 1.1
   166	        and elapsed >= minimum_seconds,
   167	        "aa_max_ratio": control_ratio,
   168	        "aa_within_round_max_ratio": max(ratios) if ratios else None,
   169	        "symmetric_aa_band": [1 / control_ratio, control_ratio] if controls else None,
   170	        "noise_label": noise_label(control_ratio),
   171	        "incomplete_round": failed,
   172	        "aa_control_max_ratio": control_ratio,
   173	        "aa_control_seconds_range": [min(controls), max(controls)] if controls else None,
   174	        "minimum_observation_seconds": minimum_seconds,
   175	        "seconds": elapsed,
   176	        **hardware,
   177	    }
   178	    append(output / "speed-results.jsonl", result)
   179	    return result
