    78	def measure(predict, rows, passes=3):
    79	    start = time.perf_counter()
    80	    expected = predict(rows)
    81	    first = time.perf_counter() - start
    82	    durations = []
    83	    for _ in range(passes):
    84	        start = time.perf_counter()
    85	        observed = predict(rows)
    86	        durations.append(time.perf_counter() - start)
    87	        if not np.array_equal(observed, expected):
    88	            raise ValueError("predictions changed across inference passes")
    89	    return expected, first, durations
