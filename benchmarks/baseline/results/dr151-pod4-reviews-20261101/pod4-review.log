    77	def split(pages: list[str], scores: np.ndarray):
    78	    order = np.random.default_rng(0).permutation(len(pages))
    79	    train, evaluation = order[:-EVAL], order[-EVAL:]
    80	    return (
    81	        [pages[i] for i in train],
    82	        scores[train] >= 3,
    83	        [pages[i] for i in evaluation],
    84	        scores[evaluation] >= 3,
    85	    )
