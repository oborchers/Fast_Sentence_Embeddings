    94	def eligible(done, checked, accepted, ratio, control_match, rows, arms):
    95	    good = (
    96	        done["complete"]
    97	        and checked["passed"]
    98	        and len(accepted) == 3
    99	        and done.get("valid_rounds") == len(accepted)
   100	        and ratio is not None
   101	        and ratio <= 1.1
   102	        and math.isclose(done.get("aa_max_ratio", 0), ratio, rel_tol=1e-12)
   103	        and control_match
   104	        and bool(rows)
   105	        and common_context(rows, checked)
   106	        and all(a["runtime_stable"] and a["output_matches_check"] for a in arms.values())
   107	    )
   108	    return good
