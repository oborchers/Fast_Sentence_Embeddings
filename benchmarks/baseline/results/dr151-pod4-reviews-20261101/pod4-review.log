    20	def norm_record(vectors, normalized):
    21	    zero_rows, low, high, error = 0, float("inf"), 0.0, 0.0
    22	    for start in range(0, len(vectors), 8192):
    23	        norms = np.linalg.norm(vectors[start : start + 8192].astype(np.float64), axis=1)
    24	        nonzero = norms > 0
    25	        zero_rows += int((~nonzero).sum())
    26	        if nonzero.any():
    27	            low = min(low, float(norms[nonzero].min()))
    28	            high = max(high, float(norms[nonzero].max()))
    29	            error = max(error, float(np.max(np.abs(norms[nonzero] - 1))))
    30	    if normalized and error > RTOL:
    31	        raise ValueError("output does not follow the declared unit-normalization policy")
    32	    return {
    33	        "zero_rows": zero_rows,
    34	        "nonzero_norm_min": low if low != float("inf") else None,
    35	        "nonzero_norm_max": high if high else None,
    36	        "max_unit_norm_error": error,
    37	    }
    38	
    39	
    40	def compare_blocks(first, vectors):
    41	    difference = 0.0
    42	    for start in range(0, len(first), 8192):
    43	        left, right = first[start : start + 8192], vectors[start : start + 8192]
    44	        if not np.isfinite(right).all():
    45	            raise ValueError("output shape/dtype/finite values differ within a same-model pair")
    46	        if not np.array_equal(np.any(left != 0, axis=1), np.any(right != 0, axis=1)):
    47	            raise ValueError("same-model pair disagrees on empty output rows")
    48	        if not np.allclose(left, right, rtol=RTOL, atol=ATOL):
    49	            raise ValueError("same-model pair differs beyond the disclosed float32 output bound")
    50	        difference = max(difference, float(np.max(np.abs(left.astype(np.float64) - right))))
    51	    return difference
