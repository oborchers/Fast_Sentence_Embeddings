    29	def recorded_files(package) -> dict[str, Path]:
    30	    if package.files is None:
    31	        raise ValueError("backend distribution has no installed-file manifest")
    32	    paths = {
    33	        "distribution/" + str(p): Path(package.locate_file(p)).resolve() for p in package.files
