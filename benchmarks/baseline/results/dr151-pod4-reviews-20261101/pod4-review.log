    45	def installed_files(package, spec) -> dict[str, Path]:
    46	    paths = recorded_files(package)
    47	    root = Path(spec.origin).resolve()
    48	    if spec.submodule_search_locations is not None:
    49	        root = root.parent
    50	        paths.update({"module/" + str(p.relative_to(root)): p.resolve() for p in root.rglob("*")})
    51	    else:
    52	        paths["module/" + root.name] = root
    53	    result, seen = {}, set()
    54	    for name, path in sorted(
    55	        paths.items(), key=lambda item: (not item[0].startswith("module/"), item[0])
    56	    ):
    57	        if stable_file(path) and path not in seen:
    58	            result[name] = path
    59	            seen.add(path)
    60	    return result
