    18	def arm(rows, checked):
    19	    first = rows[0]
    20	    stable_code = len({json.dumps(runtime(row), sort_keys=True) for row in rows}) == 1
    21	    attributed = all(
    22	        row.get("runtime_package") == PACKAGES[row["kind"]] and all(runtime(row).values())
    23	        for row in rows
    24	    )
    25	    reference = checked["records"][first["kind"]]
    26	    correct_output = all(row["output_digest"] == reference["output_digest"] for row in rows)
    27	    return {
    28	        "backend": first["kind"],
    29	        "runtime": runtime(first),
    30	        "runtime_stable": stable_code and attributed and runtime(first) == runtime(reference),
    31	        "output_matches_check": correct_output,
    32	        "ordered_rounds": [row["round"] for row in rows],
    33	        "ordered_texts_per_second": [row["texts"] / row["p50_s"] for row in rows],
    34	        "texts_per_second": spread([row["texts"] / row["p50_s"] for row in rows]),
    35	        "seconds": spread([row["p50_s"] for row in rows]),
    36	        "peak_rss_bytes": max(row["peak_rss_bytes"] for row in rows),
    37	        "file_bytes": first["file_bytes"],
    38	        "tokenizer_parallelism": first.get("tokenizer_parallelism"),
    39	        "tokenizer_thread_count": first.get("tokenizer_thread_count"),
    40	        "parallel_batch_pool": first.get("parallel_batch_pool"),
    41	        "torch_num_threads": first.get("torch_num_threads"),
    42	    }
    43	
