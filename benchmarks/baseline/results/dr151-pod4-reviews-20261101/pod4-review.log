    19	def runtime_identity() -> str:
    20	    import fse
    21	    from fse._container._hash import Hasher
    22	
    23	    root = Path(fse.__file__).resolve().parent
    24	    hasher = Hasher()
    25	    paths = [*root.rglob("*.py"), *root.glob("_native*.so"), *root.glob("_native*.pyd")]
    26	    for path in sorted(paths):
    27	        hasher.update(str(path.relative_to(root)).encode("utf-8"))
    28	        hasher.update(file_digest(path).encode("ascii"))
    29	    return hasher.checksum()
