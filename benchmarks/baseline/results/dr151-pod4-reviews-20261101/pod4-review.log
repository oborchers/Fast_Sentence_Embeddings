    15	def child_environment(threads: int) -> dict[str, str]:
    16	    if type(threads) is not int or threads < 1:
    17	        raise ValueError("threads must be a positive integer")
    18	    # Accelerate can cache this setting on its first call, before threadpoolctl.
    19	    return {**os.environ, **dict.fromkeys(NATIVE_THREAD_VARIABLES, str(threads))}
    20	
    21	
    22	def native_thread_limits() -> dict[str, str | None]:
    23	    return {key: os.environ.get(key) for key in NATIVE_THREAD_VARIABLES}
