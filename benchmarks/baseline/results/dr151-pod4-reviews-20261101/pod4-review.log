    81	def paired_ratios(rows, against):
    82	    rounds = sorted({row["round"] for row in rows})
    83	    values = []
    84	    for number in rounds:
    85	        pair = {row["label"]: row for row in rows if row["round"] == number}
    86	        values.append(pair[against]["p50_s"] / pair["fse-a"]["p50_s"])
    87	    return {
    88	        **spread(values),
    89	        "ordered_ratios": values,
    90	        "convention": "median of paired reference-time/fse-a-time ratios",
    91	    }
