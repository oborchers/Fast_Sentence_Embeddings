   203	
   204	def one_round(args, ordered, series: str, attempt: int, deadline: float | None = None) -> bool:
   205	    rows = []
   206	    context = {"series_id": series, "round": attempt}
   207	    try:
   208	        for index, (label, threads) in enumerate(ordered):
   209	            row = {
   210	                **context,
   211	                "event": "operation",
   212	                "operation_index": index,
   213	                **ready_operation(
   214	                    getattr(args, "lock", None), deadline, partial(operation, args, label, threads)
   215	                ),
   216	            }
   217	            rows.append(row)
   218	            append(args.results, row)
   219	    except (RuntimeError, FileExistsError) as error:
   220	        append(
   221	            args.results,
   222	            {
   223	                **context,
   224	                "event": "round_complete",
   225	                "valid": False,
   226	                "complete": False,
   227	                "reason": str(error),
   228	            },
   229	        )
   230	        raise
   231	    valid = all(row["valid"] for row in rows)
   232	    digests = {row["input_digest"] for row in rows}
   233	    valid = valid and len(digests) == 1
   234	    append(
   235	        args.results,
   236	        {
   237	            **context,
   238	            "event": "round_complete",
   239	            "valid": valid,
   240	            "complete": True,
   241	            "operations": len(rows),
   242	        },
   243	    )
   244	    return valid
   245	
   246	
   247	def run(args) -> None:
   248	    from fse._cpus import usable_cpus
   249	
   250	    if args.against == "model2vec" and args.threads not in (1, usable_cpus()):
   251	        raise ValueError("model2vec comparison supports one worker or the default all cores")
   252	    sides = [("fse-a", args.threads), ("fse-b", args.threads), (args.against, args.threads)]
   253	    series = uuid.uuid4().hex
   254	    deadline = time.monotonic() + args.budget_s
   255	    kept = 0
   256	    for attempt in range(args.rounds * 3):
   257	        if time.monotonic() >= deadline:
   258	            break
   259	        ordered = sides[attempt % len(sides) :] + sides[: attempt % len(sides)]
   260	        try:
   261	            kept += one_round(args, ordered, series, attempt, deadline)
   262	        except TimingBudgetExpiredError:
   263	            break
   264	        if kept == args.rounds:
   265	            break
   266	    append(
   267	        args.results,
   268	        {
   269	            "series_id": series,
   270	            "event": "series_complete",
   271	            "valid_rounds": kept,
   272	            "required_rounds": args.rounds,
   273	        },
   274	    )
   275	    if kept < args.rounds:
   276	        raise RuntimeError(f"only {kept} valid rounds, need {args.rounds}")
   277	
   278	
   279	def main() -> None:
   280	    parser = argparse.ArgumentParser(description=__doc__)
   281	    parser.add_argument("mode", choices=("run", "child"))
   282	    parser.add_argument("--model", choices=sorted(MODELS), default="minishlab/potion-base-8M")
   283	    parser.add_argument("--corpus", choices=("wikitext", "massive"), default="wikitext")
   284	    parser.add_argument("--threads", type=int, default=1)
   285	    parser.add_argument("--passes", type=int, default=5)
   286	    parser.add_argument("--warmup-texts", type=int)
   287	    parser.add_argument("--rounds", type=int, default=3)
   288	    parser.add_argument("--budget-s", type=float, default=600)
   289	    parser.add_argument(
   290	        "--against", choices=("model2vec", "st", "rust", "fastembed"), default="model2vec"
   291	    )
   292	    parser.add_argument(
   293	        "--kind", choices=("fse", "model2vec", "st", "rust", "fastembed"), default="fse"
   294	    )
   295	    parser.add_argument("--other-model", choices=sorted(MODELS))
   296	    parser.add_argument("--table-dtype", choices=("float32", "float16", "int8"), default="float32")
   297	    parser.add_argument("--fse-models", type=Path)
   298	    parser.add_argument("--other-python", type=Path)
   299	    parser.add_argument("--vectors-out", type=Path)
   300	    parser.add_argument("--canonical-newlines", action="store_true")
   301	    parser.add_argument("--lock", type=Path)
   302	    parser.add_argument("--results", type=Path)
   303	    args = parser.parse_args()
   304	    if min(args.threads, args.passes, args.rounds) < 1:
   305	        parser.error("threads, passes and rounds must be positive")
   306	    if args.warmup_texts is not None and args.warmup_texts < 1:
   307	        parser.error("warmup-texts must be positive")
   308	    if args.warmup_texts is not None and (args.kind == "rust" or args.against == "rust"):
   309	        parser.error("the Rust worker uses a full-corpus warmup")
   310	    if args.mode == "run" and args.rounds < 3:
   311	        parser.error("comparisons require at least three valid rounds")
   312	    if args.mode == "run" and (args.lock is None or args.results is None):
   313	        parser.error("run requires --lock and --results")
   314	    (child if args.mode == "child" else run)(args)
   315	
   316	
   317	if __name__ == "__main__":
   318	    main()
