     6	fn pipeline(args: &[String]) -> Result<(), Box<dyn std::error::Error>> {
     7	    if args.len() != 6 || !["full", "none"].contains(&args[5].as_str()) {
     8	        return Err("expected: --pipeline MODEL_FOLDER TEXT_FILE OUTPUT_NPY full|none".into());
     9	    }
    10	    let load = Instant::now();
    11	    let model = StaticModel::from_pretrained(&args[2], None, None, None)?;
    12	    let load_s = load.elapsed().as_secs_f64();
    13	    let start = Instant::now();
    14	    let parent = std::path::Path::new(&args[4]).parent().ok_or("output has no parent")?;
    15	    fs::create_dir(parent)?;
    16	    let sentences: Vec<String> = BufReader::new(fs::File::open(&args[3])?).lines().collect::<Result<_, _>>()?;
    17	    let vectors = model.encode(&sentences);
    18	    // Library API plus a standard NumPy v1 writer. The backend has no persisted-vector API.
    19	    let mut header = format!("{{'descr': '<f4', 'fortran_order': False, 'shape': ({}, {}), }}", sentences.len(), model.dim());
    20	    let padding = (64 - (10 + header.len() + 1) % 64) % 64;
    21	    header.push_str(&" ".repeat(padding));
    22	    header.push('\n');
    23	    let mut file = BufWriter::new(fs::File::create_new(&args[4])?);
    24	    file.write_all(b"\x93NUMPY\x01\x00")?;
    25	    file.write_all(&(header.len() as u16).to_le_bytes())?;
    26	    file.write_all(header.as_bytes())?;
    27	    for row in &vectors {
    28	        for value in row { file.write_all(&value.to_le_bytes())?; }
    29	    }
    30	    file.flush()?;
    31	    if args[5] == "full" {
    32	        file.get_ref().sync_all()?;
    33	        fs::File::open(parent)?.sync_all()?;
    34	        fs::File::open(parent.parent().ok_or("output has no grandparent")?)?.sync_all()?;
    35	    }
    36	    let seconds = start.elapsed().as_secs_f64();
    37	    println!("{}", json!({"load_s": load_s, "p50_s": seconds, "warm_seconds": [seconds],
    38	        "texts": sentences.len(), "shape": [sentences.len(), model.dim()],
    39	        "time_until_durable_s": if args[5] == "full" { Some(seconds) } else { None },
    40	        "writer": "model2vec-rs library + BufWriter NumPy v1 float32, flush, optional file and parent fsync"}));
    41	    Ok(())
    42	}
