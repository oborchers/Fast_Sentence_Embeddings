    43	def predictor(kind, folder, workers):
    44	    import fse
    45	
    46	    if kind == "mlp":
    47	        pipeline, _ = checked_pipeline(folder / "model2vec-mlp")
    48	        return lambda rows: pipeline.predict(rows, use_multiprocessing=workers > 1)
    49	    if kind == "model2vec-linear":
    50	        import joblib
    51	        from model2vec import StaticModel
    52	
    53	        model = StaticModel.from_pretrained(cached_snapshot(REPO, MODELS[REPO]), normalize=False)
    54	        head = joblib.load(folder / "same-sklearn-head.joblib")
    55	        with np.load(folder / "linear-head.npz") as recorded:
    56	            if not np.array_equal(head.coef_, recorded["weight"]) or not np.array_equal(
    57	                head.intercept_, recorded["bias"]
    58	            ):
    59	                raise ValueError("sklearn comparator does not carry the same float32 linear head")
    60	        return lambda rows: head.predict(
    61	            model.encode(rows, normalize=False, use_multiprocessing=workers > 1)
    62	        )
    63	    if kind == "folded":
    64	        model = fse.Classifier.load(folder / "folded-linear.safetensors", mmap=True)
    65	        if not model.standalone or model.normalized:
    66	            raise ValueError("folded arm must load the standalone raw-mean logit table")
    67	        return lambda rows: model.predict(rows, workers=workers)
    68	    encoder = fse.Encoder.load(folder / "raw-encoder.safetensors", mmap=True)
    69	    if encoder.steps:
    70	        raise ValueError("encode-plus-head arm must use raw means with no normalization")
    71	    with np.load(folder / "linear-head.npz") as data:
    72	        weight, bias, classes = data["weight"], data["bias"], data["classes"]
    73	    if weight.dtype != np.float32 or bias.dtype != np.float32:
    74	        raise ValueError("explicit matmul must use the exact float32 fse head")
    75	    return lambda rows: linear_predict(encoder, weight, bias, classes, rows, workers)
