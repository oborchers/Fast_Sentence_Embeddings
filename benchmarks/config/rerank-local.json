      "truncate_dim": 1024,
      "workers": 2
    },
    "potion-retrieval-32M": {
      "kind": "dense",
      "model": "minishlab/potion-retrieval-32M",
      "backend": "fse",
      "workers": 2
    },
    "all-MiniLM-L6-v2": {
      "kind": "dense",
      "model": "sentence-transformers/all-MiniLM-L6-v2",
      "backend": "st",
      "workers": 2
    },
    "bm25": {
      "kind": "bm25"
    },
    "rrf-bekko-bm25": {
      "kind": "rrf",
      "inputs": ["bekko-1024", "bm25"]
    },
    "rrf-potion-bm25": {
      "kind": "rrf",
      "inputs": ["potion-retrieval-32M", "bm25"]
    }
  },
