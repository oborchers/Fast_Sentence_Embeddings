{
  "speed": {
    "format": "allocation@1",
    "machine_check": {
      "cpu_model": "AMD EPYC 9R45",
      "required_flags": [
        "avx2",
        "fma",
        "f16c"
      ],
      "affinity_cpus": {
        "min": 32,
        "max": 32
      },
      "cpu_quota_cpus": {
        "min": 32
      },
      "memory_max_bytes": {
        "min": 128000000000,
        "max": 128000000000
      },
      "disk_free_bytes": {
        "min": 120000000000
      },
      "shm_bytes": {
        "min": 1073741824
      },
      "nofile_hard_min": 524288,
      "host_quiet": {
        "duration_seconds": 180,
        "cpu_some_percent_max": 2
      }
    },
    "rehearsal_machine_check": {
      "cpu_quota_cpus": {
        "max": 2
      },
      "memory_max_bytes": {
        "max": 6442450944
      },
      "disk_free_bytes": {
        "min": 1000000000
      },
      "shm_bytes": {
        "min": 1073741824
      },
      "nofile_hard_min": 524288
    },
    "environments": [
      {
        "name": "main",
        "role": "candidate",
        "lock": "speed-main.lock.txt",
        "revision": "pins"
      },
      {
        "name": "reference",
        "role": "reference",
        "lock": "speed-reference.lock.txt",
        "revision": null
      }
    ],
    "steps": [
      {
        "name": "speed",
        "environment": "main",
        "estimate_seconds": 60,
        "command": [
          "{python}",
          "{source}/benchmarks/speed.py",
          "{mode}",
          "--input",
          "{input}",
          "--results",
          "{results}",
          "--work",
          "{work}",
          "--allocated-at",
          "{allocated_at}",
          "--reference-python",
          "{python_reference}",
          "--study",
          "readme"
        ]
      },
      {
        "name": "profile-libraries-cpu",
        "environment": "main",
        "estimate_seconds": 360,
        "command": [
          "{python}",
          "{source}/benchmarks/speed.py",
          "--allocation-profile",
          "py-spy",
          "--allocation-root",
          "{root}",
          "--allocation",
          "{source}/benchmarks/config/allocation-readme-aws.json",
          "--study",
          "readme",
          "--input",
          "{input}",
          "--allocated-at",
          "{allocated_at}",
          "--results",
          "{results}",
          "--work",
          "{work}",
          "--profile-cell",
          "libraries-model2vec-16",
          "--profile-seconds",
          "360"
        ]
      },
      {
        "name": "profile-libraries-memory",
        "environment": "main",
        "estimate_seconds": 360,
        "command": [
          "{python}",
          "{source}/benchmarks/speed.py",
          "--allocation-profile",
          "memray",
          "--allocation-root",
          "{root}",
          "--allocation",
          "{source}/benchmarks/config/allocation-readme-aws.json",
          "--study",
          "readme",
          "--input",
          "{input}",
          "--allocated-at",
          "{allocated_at}",
          "--results",
          "{results}",
          "--work",
          "{work}",
          "--profile-cell",
          "libraries-model2vec-16",
          "--profile-seconds",
          "360"
        ]
      },
      {
        "name": "profile-heads-sinks-cpu",
        "environment": "main",
        "estimate_seconds": 360,
        "command": [
          "{python}",
          "{source}/benchmarks/speed.py",
          "--allocation-profile",
          "py-spy",
          "--allocation-root",
          "{root}",
          "--allocation",
          "{source}/benchmarks/config/allocation-readme-aws.json",
          "--study",
          "readme",
          "--input",
          "{input}",
          "--allocated-at",
          "{allocated_at}",
          "--results",
          "{results}",
          "--work",
          "{work}",
          "--profile-cell",
          "heads-sinks-16",
          "--profile-seconds",
          "360"
        ]
      },
      {
        "name": "profile-heads-sinks-memory",
        "environment": "main",
        "estimate_seconds": 360,
        "command": [
          "{python}",
          "{source}/benchmarks/speed.py",
          "--allocation-profile",
          "memray",
          "--allocation-root",
          "{root}",
          "--allocation",
          "{source}/benchmarks/config/allocation-readme-aws.json",
          "--study",
          "readme",
          "--input",
          "{input}",
          "--allocated-at",
          "{allocated_at}",
          "--results",
          "{results}",
          "--work",
          "{work}",
          "--profile-cell",
          "heads-sinks-16",
          "--profile-seconds",
          "360"
        ]
      }
    ],
    "toolchains": [
      "rust"
    ]
  }
}
