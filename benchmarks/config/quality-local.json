      "model": "minishlab/potion-base-8M",
      "corpus": "wikitext",
      "stage": "encode-sink"
    },
    {
      "id": "retrieval-stsb-ids",
      "model": "sentence-transformers/static-retrieval-mrl-en-v1",
      "corpus": "stsb",
      "stage": "encode-sink"
    },
    {
      "id": "retrieval-wikitext-ids",
      "model": "sentence-transformers/static-retrieval-mrl-en-v1",
      "corpus": "wikitext",
      "stage": "encode-sink"
    }
  ]
